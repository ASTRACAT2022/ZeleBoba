{% extends 'base.html.twig' %}{% block title %}Компенсации{% endblock %}{% block content %}<header><div><p class="eyebrow">МАССОВЫЕ ОПЕРАЦИИ</p><h1>Компенсации.</h1><p class="muted">Массовое начисление денег, дней или трафика по сегментам пользователей.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Новая компенсация</h2><form method="post" action="/admin/compensations" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Сегмент<select name="segment"><option value="all">Все пользователи</option><option value="active">С активной подпиской</option><option value="inactive">Без активной подписки</option><option value="paid">Оплачивавшие</option><option value="trial">На триале</option><option value="telegram">С Telegram</option></select></label><label>Тип<select name="kind"><option value="balance">Деньги на баланс</option><option value="days">Дни подписки</option><option value="traffic">Трафик, ГБ</option></select></label><label>Значение<input type="number" name="value" min="1" max="100000000" required placeholder="500 (₽/дней/ГБ)"></label><label class="span-two">Причина<input name="reason" required maxlength="200" placeholder="Компенсация за простой 10.09"></label><button class="button">Запустить компенсацию →</button></form><p class="muted">Дни начисляются к активной подписке или создают новую. Трафик — только к активной подписке с лимитом. Каждый пользователь получает компенсацию ровно один раз.</p></section><section class="panel detail"><h2>История</h2>{% if compensations %}<table><thead><tr><th>Сегмент</th><th>Тип</th><th>Значение</th><th>Причина</th><th>Обработано</th><th>Статус</th><th>Дата</th></tr></thead><tbody>{% for c in compensations %}<tr><td>{{ c.segment }}</td><td>{{ c.kind }}</td><td>{{ c.value }}</td><td><small>{{ c.reason }}</small></td><td>{{ c.processed_count }}/{{ c.total_count }}</td><td><span class="badge {{ c.status == 'completed' ? 'fulfilled' : 'pending' }}">{{ c.status }}</span></td><td>{{ c.created_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Компенсаций пока нет.</p>{% endif %}</section>{% endblock %}
