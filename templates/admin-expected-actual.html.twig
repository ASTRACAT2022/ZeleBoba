{% extends 'base.html.twig' %}
{% block title %}Ожидаемое и фактическое{% endblock %}
{% block content %}
<header><div><p class="eyebrow">ПРОВЕРКА СОСТОЯНИЯ</p><h1>Ожидаемое и фактическое.</h1><p class="muted">Подписка {{ comparison.subscription.id }} · {% if comparison.freshness is not null %}данные получены из Remnawave сейчас{% else %}данные Remnawave не получены{% endif %}</p></div><a class="button light" href="/admin/subscriptions/{{ comparison.subscription.id }}">← Подписка</a></header>
{% include '_admin-nav.html.twig' %}
{% if comparison.error %}<div class="notice error">{{ comparison.error }}</div>{% endif %}
<section class="panel detail"><table><thead><tr><th>Параметр</th><th>Ожидается в Billing</th><th>Фактически в Remnawave</th><th></th></tr></thead><tbody>{% for row in comparison.rows %}<tr><td>{{ row.name }}</td><td>{{ row.expected }}</td><td>{{ row.actual }}</td><td>{{ row.ok ? '✓ Совпадает' : '✕ Требует проверки' }}</td></tr>{% endfor %}</tbody></table></section>
{% endblock %}
