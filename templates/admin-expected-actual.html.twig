{% extends 'base.html.twig' %}{% block title %}Ожидаемое и фактическое{% endblock %}{% block content %}<header><div><p class="eyebrow">ПРОВЕРКА СОСТОЯНИЯ</p><h1>Ожидаемое и фактическое.</h1><p class="muted">Подписка {{ comparison.subscription.id }} · данные Remnawave: {% if comparison.freshness is null %}ещё не синхронизировались{% else %}{{ comparison.freshness }} сек. назад{% endif %}</p></div><a class="button light" href="/admin/subscriptions/{{ comparison.subscription.id }}">← Подписка</a></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><table><thead><tr><th>Параметр</th><th>Ожидается в Billing</th><th>Фактически</th><th></th></tr></thead><tbody>{% for row in comparison.rows %}<tr><td>{{ row.name }}</td><td>{{ row.expected }}</td><td>{{ row.actual }}</td><td>{{ row.ok ? '✓ Совпадает' : '✕ Расхождение' }}</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
