{% extends 'base.html.twig' %}{% block title %}Почему подписка в этом состоянии?{% endblock %}{% block content %}<header><h1>Почему подписка {{ state.status }}?</h1><p class="muted">Действует до {{ state.expires_at|date('d.m.Y H:i') }}</p></header><section class="panel detail"><h2>Причина</h2><ol class="customer-timeline">{% for r in state.reasons %}<li><time>{{ r.at|date('d.m.Y H:i:s') }}</time><span>{{ r.status == 'success' ? '✅' : (r.status == 'failed' ? '❌' : '⚠') }} {{ r.text }}</span></li>{% endfor %}</ol>{% if state.provisioning %}<p>Выдача VPN: <strong>{{ state.provisioning.state }}</strong>{% if state.provisioning.last_synced_at %} · последняя синхронизация {{ state.provisioning.last_synced_at|date('d.m.Y H:i:s') }}{% endif %}</p>{% endif %}</section>{% endblock %}
