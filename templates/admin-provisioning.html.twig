{% extends 'base.html.twig' %}{% block title %}Контроль выдачи VPN{% endblock %}{% block content %}<header><div><p class="eyebrow">ОПЕРАЦИОННЫЙ ЦЕНТР</p><h1>Контроль выдачи VPN.</h1><p class="muted">Состояние исполнения прав пользователя в Remnawave.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel provisioning-panel"><div class="provisioning-heading"><span>Подписка и клиент</span><span>Ожидаемое состояние</span><span>Синхронизация</span><span></span></div><div class="provisioning-list">{% for a in accounts %}<article class="provisioning-row"><div class="provisioning-person"><strong>sub_{{ a.subscription_id|slice(0,8) }}</strong><small>{{ a.email ?? ('TG ' ~ a.telegram_id) }}</small><small class="provisioning-provider">{{ a.provider }}</small></div><div class="provisioning-desired"><strong>Активна до {{ a.expires_at|date('d.m.Y') }}</strong><small>Источник истины — Billing</small></div><div class="provisioning-state"><span class="badge {{ a.state == 'active' ? 'fulfilled' : (a.state == 'failed' ? 'canceled' : 'pending') }}">{{ a.state == 'active' ? 'Синхронизирована' : (a.state == 'retry' ? 'Повтор в очереди' : (a.state == 'failed' ? 'Ошибка' : 'Ожидает')) }}</span><small>{{ a.last_synced_at ? 'Проверено ' ~ (a.last_synced_at|date('d.m H:i')) : 'Ещё не синхронизировалась' }}</small></div><div class="provisioning-action">{% if a.state != 'active' %}<form method="post" action="/admin/provisioning/{{ a.id }}/retry"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label class="sr-only">Причина повторной выдачи</label><input name="reason" required maxlength="200" placeholder="Причина"><button class="button small">Повторить</button></form>{% else %}<span class="provisioning-ok">✓ В норме</span>{% endif %}</div></article>{% else %}<p class="empty">Очередь выдачи пуста.</p>{% endfor %}</div></section>{% endblock %}
