{% extends 'base.html.twig' %}{% block title %}Provisioning Monitor{% endblock %}{% block content %}<header><div><p class="eyebrow">OBSERVABILITY</p><h1>Provisioning Monitor.</h1><p class="muted">Состояние исполнения прав пользователя в Remnawave.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><table><thead><tr><th>Subscription</th><th>User</th><th>Provider</th><th>Desired</th><th>Status</th><th>Last sync</th><th></th></tr></thead><tbody>{% for a in accounts %}<tr><td>{{ a.subscription_id }}</td><td>{{ a.email ?? ('TG ' ~ a.telegram_id) }}</td><td>{{ a.provider }}</td><td>ACTIVE / {{ a.expires_at|date('d.m.Y') }}</td><td><span class="badge {{ a.state == 'active' ? 'fulfilled' : (a.state == 'failed' ? 'canceled' : 'pending') }}">{{ a.state }}</span></td><td>{{ a.last_synced_at ? a.last_synced_at|date('d.m.Y H:i:s') : '—' }}</td><td>{% if a.state != 'active' %}<form method="post" action="/admin/provisioning/{{ a.id }}/retry" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input name="reason" required maxlength="200" placeholder="Причина"><button class="button small">Retry now</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
