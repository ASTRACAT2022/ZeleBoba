{% extends 'base.html.twig' %}{% block title %}Контроль выдачи VPN{% endblock %}{% block content %}<header><div><p class="eyebrow">ОПЕРАЦИОННЫЙ ЦЕНТР</p><h1>Контроль выдачи VPN.</h1><p class="muted">Состояние исполнения прав пользователя в Remnawave.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><table><thead><tr><th>Подписка</th><th>Пользователь</th><th>Провайдер</th><th>Требуемое состояние</th><th>Статус</th><th>Последняя синхронизация</th><th></th></tr></thead><tbody>{% for a in accounts %}<tr><td>{{ a.subscription_id }}</td><td>{{ a.email ?? ('TG ' ~ a.telegram_id) }}</td><td>{{ a.provider }}</td><td>АКТИВНА / {{ a.expires_at|date('d.m.Y') }}</td><td><span class="badge {{ a.state == 'active' ? 'fulfilled' : (a.state == 'failed' ? 'canceled' : 'pending') }}">{{ a.state }}</span></td><td>{{ a.last_synced_at ? a.last_synced_at|date('d.m.Y H:i:s') : '—' }}</td><td>{% if a.state != 'active' %}<form method="post" action="/admin/provisioning/{{ a.id }}/retry" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input name="reason" required maxlength="200" placeholder="Причина"><button class="button small">Повторить выдачу</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
