{% extends 'base.html.twig' %}{% block title %}Тарифы сервиса{% endblock %}{% block content %}<header><div><p class="eyebrow">КАТАЛОГ ПОДПИСОК</p><h1>Тарифы для ваших клиентов.</h1><p class="muted">Изменения действуют для новых заказов. Цена уже созданного заказа сохраняется.</p></div><a class="button" href="/admin#new-plan">+ Создать тариф</a></header>{% include '_admin-nav.html.twig' %}{% for p in plans %}<section class="panel detail"><div class="section-heading compact"><h2>{{ p.name }}</h2><span class="badge {{ p.active ? 'fulfilled' : '' }}">{{ p.active ? 'В продаже' : 'Скрыт' }}</span></div><form method="post" action="/admin/plans/{{ p.id }}" class="form-grid three"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Название<input name="name" value="{{ p.name }}" required maxlength="100"></label><label>Цена, копейки<input name="price_minor" type="number" min="100" max="100000000" value="{{ p.price_minor }}" required></label><label>Период, дни<input name="duration_days" type="number" min="1" max="3650" value="{{ p.duration_days }}" required></label><label>Устройства · 0 = безлимит<input name="devices" type="number" min="0" max="20" value="{{ p.devices }}" required></label><label>Трафик, ГБ · 0 = безлимит<input name="traffic_gb" type="number" min="0" value="{{ p.traffic_bytes / 1073741824 }}" required></label><label>Группа Remnawave<input name="squad_uuid" value="{{ p.squad_uuid }}" placeholder="По умолчанию"></label><label>Доступность<select name="active"><option value="1" {{ p.active ? 'selected' : '' }}>В продаже</option><option value="0" {{ not p.active ? 'selected' : '' }}>Скрыт</option></select></label><button class="button align-end">Сохранить тариф →</button></form></section>{% else %}<section class="panel empty">Тарифов ещё нет. Добавьте первый.</section>{% endfor %}{% endblock %}
