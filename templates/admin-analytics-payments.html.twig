{% extends 'base.html.twig' %}{% block title %}Аналитика платежей{% endblock %}{% block content %}
<header><div><p class="eyebrow">БИЗНЕС-АНАЛИТИКА</p><h1>Платёжная воронка.</h1><p class="muted">Статусы попыток оплаты и нормализованные причины отмен.</p></div></header>{% include '_admin-nav.html.twig' %}
<section class="panel detail"><form method="get" action="/admin/analytics/payments" class="row-form"><label>Период<select name="days"><option value="7" {{ days == 7 ? 'selected' : '' }}>7 дней</option><option value="30" {{ days == 30 ? 'selected' : '' }}>30 дней</option><option value="90" {{ days == 90 ? 'selected' : '' }}>90 дней</option></select></label><button class="button">Обновить →</button><a class="button secondary" href="/admin/analytics">Обзор</a></form></section>
{% set paymentMetrics = [{label:'Успех оплаты',value:stats.payment_success_rate ~ '%',secondary:days ~ ' дней'},{label:'Создано попыток',value:stats.payment_attempts.stages.created ?? 0,secondary:'Все способы оплаты'},{label:'Median time to pay',value:stats.median_time_to_pay ~ ' сек.',secondary:'От создания до успешной оплаты'},{label:'Checkout conversion',value:stats.payment_attempts.stages.created ? ((stats.payment_attempts.stages.succeeded * 100 / stats.payment_attempts.stages.created)|round(1)) ~ '%' : '—',secondary:'Попытка создана → платёж успешен'}] %}{% include '@patterns/metric-rail.html.twig' with {metrics:paymentMetrics,label:'Платёжные метрики'} only %}
<section class="panel detail"><h2>Путь платёжной попытки</h2><div class="table-wrap"><table><thead><tr><th>Этап</th><th>Количество</th></tr></thead><tbody>{% for key,label in {created:'Создано',redirected:'Перешли к оплате',returned:'Вернулись на сайт',succeeded:'Успешно',cancelled:'Отменено',failed:'Ошибка',expired:'Истекло',pending:'Ожидает результата'} %}<tr><td>{{ label }}</td><td>{{ stats.payment_attempts.stages[key] ?? 0 }}</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel detail"><h2>Попытки по статусам</h2><div class="table-wrap"><table><thead><tr><th>Статус</th><th>Количество</th></tr></thead><tbody>{% for item in stats.payment_attempts.states %}<tr><td>{{ item.status }}</td><td>{{ item.count }}</td></tr>{% else %}<tr><td colspan="2">Нет попыток в этом периоде.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel detail"><h2>Причины отмен и ошибок</h2><p class="muted">Сообщения и коды, которые Platega вернула при проверке платежа. Секреты и реквизиты не сохраняются.</p><div class="table-wrap"><table><thead><tr><th>Причина</th><th>Количество</th></tr></thead><tbody>{% for item in stats.payment_attempts.reasons %}<tr><td>{{ item.reason }}</td><td>{{ item.count }}</td></tr>{% else %}<tr><td colspan="2">Нет отмен и ошибок в выбранном периоде.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel detail"><h2>Провайдеры и способы оплаты</h2><div class="table-wrap"><table><thead><tr><th>Провайдер</th><th>Метод</th><th>Статус</th><th>Количество</th></tr></thead><tbody>{% for row in stats.payment_attempts.providers %}<tr><td>{{ row.provider }}</td><td>{{ row.payment_method }}</td><td>{{ row.status }}</td><td>{{ row.count }}</td></tr>{% else %}<tr><td colspan="4">Нет данных.</td></tr>{% endfor %}</tbody></table></div></section>
<section class="panel detail"><h2>Попытки оплаты по тарифам</h2><div class="table-wrap"><table><thead><tr><th>План</th><th>Статус попытки</th><th>Попытки</th></tr></thead><tbody>{% for row in stats.payment_attempts.plans %}<tr><td>{{ row.plan_name ?? '—' }}</td><td>{{ row.status }}</td><td>{{ row.count }}</td></tr>{% else %}<tr><td colspan="3">Нет данных.</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
