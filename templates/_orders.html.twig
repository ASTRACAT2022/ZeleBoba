{% set statuses = {'pending':'Ожидает','paid':'Выдаём доступ','fulfilled':'Успешно','canceled':'Отменён','payment_unavailable':'Недоступно','refunded':'Возврат'} %}{% if orders %}<div class="table-wrap table-cards"><table><thead><tr><th>Дата</th><th>Описание</th><th>Статус</th><th class="table-actions">Сумма</th></tr></thead><tbody>{% for o in orders %}<tr>
<td data-label="Дата">{{ o.created_at|date('d.m.Y') }}</td>
<td data-label="Описание"><strong>{{ o.plan_name }}</strong><small>Заказ #{{ o.id|slice(0,8) }}</small></td>
<td data-label="Статус"><span class="badge {{ o.status }}">{{ statuses[o.status] ?? o.status }}</span></td>
<td class="amount table-actions" data-label="Сумма"><a href="/orders/{{ o.id }}" aria-label="Открыть заказ {{ o.id|slice(0,8) }}">{{ o.price_minor|rub }} ↗</a></td>
</tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty"><span aria-hidden="true">≡</span><h3>Пока нет платежей</h3><p>Выберите тариф — история оплаты появится здесь.</p><a href="/plans">Посмотреть тарифы →</a></div>{% endif %}
