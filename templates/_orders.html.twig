{% set statuses = {'pending':'Ожидает оплаты','paid':'Выдаём подписку','fulfilled':'Завершён','canceled':'Отменён','payment_unavailable':'Оплата недоступна'} %}{% if orders %}<div class="table-wrap"><table><thead><tr><th>Заказ / тариф</th><th>Дата</th><th>Сумма</th><th>Статус</th><th></th></tr></thead><tbody>{% for o in orders %}<tr><td><strong>{{ o.plan_name }}</strong><small>#{{ o.id|slice(0,8) }}</small></td><td>{{ o.created_at|date('d.m.Y') }}</td><td class="amount">{{ o.price_minor|rub }}</td><td><span class="badge {{ o.status }}">{{ statuses[o.status] }}</span></td><td><a aria-label="Открыть заказ {{ o.id|slice(0,8) }}" href="/orders/{{ o.id }}">↗</a></td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="empty"><span>≡</span><h3>Пока нет заказов</h3><p>Выберите тариф — история оплаты появится здесь.</p><a href="/plans">Посмотреть тарифы →</a></div>{% endif %}
