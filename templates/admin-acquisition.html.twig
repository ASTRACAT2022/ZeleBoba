{% extends 'base.html.twig' %}{% block title %}Источники и кампании{% endblock %}{% block content %}
<header><div><p class="eyebrow">БИЗНЕС-АНАЛИТИКА</p><h1>Кампании и источники.</h1><p class="muted">Регистрации, покупатели, атрибутированная выручка, CAC и ROAS.</p></div></header>{% include '_admin-nav.html.twig' %}
<section class="panel detail"><h2>Добавить маркетинговую кампанию</h2><p class="muted">Ключ должен совпадать с utm_campaign в ссылке. Расход указывается в рублях.</p><form method="post" action="/admin/analytics/campaigns" class="form-grid"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="currency" value="RUB"><label>UTM campaign<input name="campaign_key" maxlength="160" required placeholder="september_traffic_01"></label><label>Название<input name="name" maxlength="255" required placeholder="Telegram September #1"></label><label>Источник<input name="source" maxlength="120" required placeholder="telegram"></label><label>Канал<input name="medium" maxlength="120" placeholder="ads"></label><label>Расход, ₽<input type="number" name="spend" min="0" max="100000000" step="1" value="0" required></label><label>Начало<input type="date" name="started_at"></label><label>Окончание<input type="date" name="ended_at"></label><button class="button">Сохранить кампанию →</button></form></section>
<section class="panel detail"><h2>Результаты кампаний</h2><div class="table-wrap"><table><thead><tr><th>Кампания</th><th>Регистрации</th><th>Покупатели</th><th>Выручка</th><th>Конверсия</th><th>CAC</th><th>ARPPU</th><th>ROAS</th></tr></thead><tbody>{% for campaign in campaigns %}<tr><td><strong>{{ campaign.name }}</strong><small>{{ campaign.source }} / {{ campaign.medium ?? '—' }} · utm_campaign={{ campaign.campaign_key }}</small></td><td>{{ campaign.registrations }}</td><td>{{ campaign.buyers }}</td><td>{{ campaign.revenue|rub }}</td><td>{{ campaign.conversion is null ? '—' : campaign.conversion ~ '%' }}</td><td>{{ campaign.cac is null ? 'N/A' : (campaign.cac|rub) }}</td><td>{{ campaign.arppu is null ? 'N/A' : (campaign.arppu|rub) }}</td><td>{{ campaign.roas is null ? 'N/A' : campaign.roas ~ '×' }}</td></tr>{% else %}<tr><td colspan="8">Добавьте кампанию и используйте её ключ в utm_campaign.</td></tr>{% endfor %}</tbody></table></div></section>
{% endblock %}
