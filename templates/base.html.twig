<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light dark">{% if favicon %}<link rel="icon" href="{{ favicon }}">{% endif %}<title>{% block title %}Кабинет{% endblock %} · {{ site_name }}</title><style nonce="{{ style_nonce }}">:root{ {{ css_vars }} }</style><script src="/theme.js"></script>{% if is_staff %}<script defer src="/control.js"></script>{% endif %}<link rel="stylesheet" href="/app.css"></head><body><button class="theme-toggle" type="button" data-theme-toggle aria-label="Включить тёмную тему" aria-pressed="false"><span aria-hidden="true" data-theme-icon>◐</span><span data-theme-label>Тёмная тема</span></button>
{% if user %}<aside class="sidebar"><a class="brand" href="/">{% if logo %}<img class="logo-img" src="{{ logo }}" alt="{{ site_name }}">{% else %}<span class="logo">z</span>{% endif %}{{ site_name }}<span class="brand-dot">®</span></a><div class="workspace">ЛИЧНЫЙ КАБИНЕТ</div><nav><a href="/" class="{{ path == '/' ? 'selected' : '' }}"><span>◫</span>Обзор</a><a href="/plans" class="{{ path == '/plans' ? 'selected' : '' }}"><span>⊞</span>Тарифы</a><a href="/orders" class="{{ path starts with '/orders' ? 'selected' : '' }}"><span>≡</span>Платежи</a><a href="/balance" class="{{ path starts with '/balance' ? 'selected' : '' }}"><span>◉</span>Баланс</a><a href="/referral" class="{{ path starts with '/referral' ? 'selected' : '' }}"><span>↗</span>Рефералы</a><a href="/settings" class="{{ path == '/settings' ? 'selected' : '' }}"><span>⚙</span>Настройки</a>{% if is_staff %}<a href="/admin" class="{{ path starts with '/admin' ? 'selected' : '' }}"><span>⌘</span>Управление</a>{% endif %}</nav><div class="sidebar-bottom"><div class="avatar">{{ (user.email ?? 'TG')|slice(0,1)|upper }}</div><div class="account">{{ user.email ?? 'Telegram-аккаунт' }}<small>{{ user.role == 'admin' ? 'Администратор' : 'Личный аккаунт' }}</small></div><form method="post" action="/logout"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="signout" aria-label="Выйти">↗</button></form></div></aside>{% endif %}
<main class="{{ user ? 'main' : 'auth-main' }}">{% if demo %}<div class="demo-bar"><span class="dot"></span>Деморежим <span>Платежи и подключение могут быть тестовыми. Реальные деньги не списываются при демооплате.</span></div>{% endif %}{% block content %}{% endblock %}{% if support_url %}<a class="support-link" href="{{ support_url }}" rel="noreferrer">Нужна помощь? →</a>{% endif %}<footer>{{ site_name }} <span>{{ footer_text ?: 'Личный кабинет подписок' }}</span></footer></main></body></html>
