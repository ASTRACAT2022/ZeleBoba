<!doctype html><html lang="ru"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="color-scheme" content="light dark">{% if favicon %}<link rel="icon" href="{{ favicon }}">{% else %}<link rel="icon" href="/branding/favicon.ico">{% endif %}<link rel="apple-touch-icon" href="/branding/apple-touch-icon.png"><title>{% block title %}Кабинет{% endblock %} · {{ site_name }}</title><script src="/theme.js"></script><script defer src="/app.js"></script>{% if is_staff %}<script defer src="/control.js"></script>{% endif %}<link rel="stylesheet" href="/app.css"><link rel="stylesheet" href="/stripe.css"><style nonce="{{ style_nonce }}">:root{ {{ css_vars }} }</style></head><body><a class="skip-link" href="#main-content">К содержимому</a><button class="theme-toggle" type="button" data-theme-toggle aria-label="Включить тёмную тему" aria-pressed="false"><span aria-hidden="true" data-theme-icon>◐</span><span data-theme-label>Тема</span></button>
{% if user %}<aside class="sidebar">
<a class="brand" href="/">{% if logo %}<img class="logo-img" src="{{ logo }}" alt="">{% else %}<span class="brand-mark" aria-hidden="true">A</span>{% endif %}<span>{{ site_name }}</span></a>
<div class="workspace">Личный кабинет</div>
<nav aria-label="Основная навигация">
<a href="/" class="{{ path == '/' ? 'selected' : '' }}" {% if path == '/' %}aria-current="page"{% endif %}><span aria-hidden="true">◫</span>Обзор</a>
<a href="/plans" class="{{ path == '/plans' ? 'selected' : '' }}" {% if path == '/plans' %}aria-current="page"{% endif %}><span aria-hidden="true">⊞</span>Тарифы</a>
<a href="/orders" class="{{ path starts with '/orders' ? 'selected' : '' }}" {% if path starts with '/orders' %}aria-current="page"{% endif %}><span aria-hidden="true">≡</span>Платежи</a>
<a href="/balance" class="{{ path starts with '/balance' ? 'selected' : '' }}" {% if path starts with '/balance' %}aria-current="page"{% endif %}><span aria-hidden="true">◉</span>Баланс</a>
</nav>
<div class="nav-group"><div class="workspace">Ещё</div><nav aria-label="Дополнительная навигация">
<a href="/referral" class="{{ path starts with '/referral' ? 'selected' : '' }}" {% if path starts with '/referral' %}aria-current="page"{% endif %}><span aria-hidden="true">↗</span>Рефералы</a>
{% if creator_active %}<a href="/creators" class="{{ path starts with '/creators' ? 'selected' : '' }}" {% if path starts with '/creators' %}aria-current="page"{% endif %}><span aria-hidden="true">✦</span>Creator Program</a>{% endif %}
<a href="/settings" class="{{ path == '/settings' ? 'selected' : '' }}" {% if path == '/settings' %}aria-current="page"{% endif %}><span aria-hidden="true">⚙</span>Настройки</a>
{% if is_staff %}<a href="/admin" class="{{ path starts with '/admin' ? 'selected' : '' }}" {% if path starts with '/admin' %}aria-current="page"{% endif %}><span aria-hidden="true">⌘</span>Управление</a>{% endif %}
</nav></div>
<div class="sidebar-bottom"><span class="avatar" aria-hidden="true">{{ (user.email ?? 'A')|slice(0,1)|upper }}</span><div class="account">{{ user.email ?? 'Telegram-аккаунт' }}<small>{{ user.role == 'admin' ? 'Администратор' : 'Личный аккаунт' }}</small></div><form method="post" action="/logout"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="signout" aria-label="Выйти" data-tooltip="Выйти">↗</button></form></div>
</aside>{% endif %}
<main id="main-content" class="{{ user ? 'main' : 'auth-main' }}">{% if demo %}<div class="demo-bar alert alert-warning" role="status"><span class="alert-icon" aria-hidden="true">◆</span><span><strong>Деморежим.</strong> Платежи и подключение могут быть тестовыми, реальные деньги не списываются.</span></div>{% endif %}{% block content %}{% endblock %}{% if support_url %}<a class="support-link" href="{{ support_url }}" rel="noreferrer">Нужна помощь? →</a>{% endif %}<footer><span>{{ site_name }}</span><span>{{ footer_text ?: 'Личный кабинет подписок' }}</span></footer></main></body></html>
