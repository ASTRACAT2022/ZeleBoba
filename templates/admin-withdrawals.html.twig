{% extends 'base.html.twig' %}{% block title %}Заявки на вывод{% endblock %}{% block content %}<header><div><p class="eyebrow">ФИНАНСЫ</p><h1>Заявки на вывод.</h1><p class="muted">Реферальные выплаты.</p></div></header>{% include '_admin-nav.html.twig' %}{% if withdrawals %}<section class="panel detail"><table><thead><tr><th>Пользователь</th><th>Сумма</th><th>Реквизиты</th><th>Риск</th><th>Дата</th><th>Действие</th></tr></thead><tbody>{% for w in withdrawals %}<tr><td>{{ w.email ?? ('TG ' ~ w.telegram_id) }}</td><td>{{ (w.amount_kopeks / 100)|round(0, 'floor') }} ₽</td><td><small>{{ w.payment_details }}</small></td><td><span class="badge {{ w.risk_score >= 50 ? 'canceled' : 'fulfilled' }}">{{ w.risk_score }}</span></td><td>{{ w.created_at|date('d.m.Y H:i') }}</td><td><form method="post" action="/admin/withdrawals/{{ w.id }}" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><select name="status"><option value="approved">Одобрить</option><option value="rejected">Отклонить</option><option value="paid">Выплачено</option></select><input type="text" name="admin_comment" placeholder="Комментарий" maxlength="255"><button class="button small">ОК</button></form></td></tr>{% endfor %}</tbody></table></section>{% else %}<p class="muted">Заявок нет.</p>{% endif %}{% endblock %}
