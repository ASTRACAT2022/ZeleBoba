{% extends '_miniapp_layout.html.twig' %}
{% block title %}Главная{% endblock %}
{% block page_id %}home{% endblock %}
{% block content %}
<section class="balance-card">
  <div class="balance-top">
    <span class="balance-label">Ваш баланс</span>
    <span class="balance-pill">RUB</span>
  </div>
  <div class="balance-amount"><span class="num">{{ balance_kopeks|rub }}</span></div>
  <div class="balance-actions">
    <a class="btn-primary" href="/miniapp/balance" data-haptic="success">Пополнить</a>
    <a class="btn-ghost" href="/miniapp/referral" data-haptic="light">Рефералы</a>
  </div>
</section>

<section class="block">
  <div class="block-head"><h2>Подписки</h2>{% if subscriptions %}<span class="block-meta">{{ subscriptions|length }}</span>{% endif %}</div>
  {% if subscriptions %}
    <div class="sub-list">
    {% for s in subscriptions %}
      <article class="sub-card">
        <div class="sub-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4Z"/></svg>
        </div>
        <div class="sub-body">
          <div class="sub-name">{{ s.plan_name }}</div>
          <div class="sub-meta">{% if s.status == 'active' and s.expires_at > now %}Активна до {{ s.expires_at|date('d.m.Y') }}{% else %}Статус: {{ s.status }}{% endif %}</div>
        </div>
        <span class="sub-status {% if s.status == 'active' and s.expires_at > now %}ok{% else %}warn{% endif %}">
          {% if s.status == 'active' and s.expires_at > now %}активна{% else %}{{ s.status }}{% endif %}
        </span>
      </article>
    {% endfor %}
    </div>
  {% else %}
    <div class="empty">
      <div class="empty-emoji" aria-hidden="true">🛡</div>
      <p>Подписок пока нет</p>
      <small>Выберите тариф ниже — после оплаты появится здесь.</small>
    </div>
  {% endif %}
</section>

<section class="quick-actions">
  <a class="quick" href="/miniapp/orders" data-haptic="light">
    <span class="quick-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11h6M9 15h4M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg></span>
    <span class="quick-label">Платежи</span>
  </a>
  <a class="quick" href="/miniapp/referral" data-haptic="light">
    <span class="quick-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
    <span class="quick-label">Рефералы</span>
  </a>
  <a class="quick" href="/miniapp/settings" data-haptic="light">
    <span class="quick-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg></span>
    <span class="quick-label">Профиль</span>
  </a>
  <a class="quick" href="/miniapp/plans" data-haptic="light">
    <span class="quick-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
    <span class="quick-label">Тарифы</span>
  </a>
</section>
{% endblock %}
