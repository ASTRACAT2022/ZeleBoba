{% extends 'base.html.twig' %}{% block title %}Контроль системы{% endblock %}{% block content %}
<header><div><p class="eyebrow">ОПЕРАЦИОННЫЙ ЦЕНТР</p><h1>Контроль системы.</h1><p class="muted">Инварианты, масштаб сбоя, безопасный режим и плановые работы — в одном месте.</p></div></header>{% include '_admin-nav.html.twig' %}
{% if checked %}<p class="success">Проверка инвариантов завершена. Для найденных проблем созданы кейсы.</p>{% endif %}
<section class="ops-kpi"><article><small>Проверки инвариантов</small><strong>{{ checks.checked }}</strong><span class="{{ checks.ok ? 'positive' : 'negative' }}">{{ checks.ok ? 'Все в норме' : 'Есть нарушения' }}</span></article><article><small>Открытые кейсы</small><strong>{{ cases|length }}</strong><span>Требуют разбора</span></article><article><small>Безопасный режим</small><strong>{{ safety ? 'ВКЛ' : 'ВЫКЛ' }}</strong><span>{{ safety ? 'Рискованные действия заблокированы' : 'Обычная работа' }}</span></article></section>
<section class="panel detail"><h2>Масштаб недоступности Remnawave</h2><div class="ops-kpi"><article><small>Затронутые клиенты</small><strong>{{ blast.affected_users }}</strong></article><article><small>Активные подписки</small><strong>{{ blast.active_subscriptions }}</strong></article><article><small>Выдача задержана</small><strong>{{ blast.provisioning_delayed }}</strong><span>Денег под риском: {{ blast.money_at_risk_minor|rub }}</span></article></div></section>
<section class="panel detail"><div class="section-title"><span class="section-number">1</span><div><h2>Инварианты Billing</h2><p>Каждая успешная оплата должна иметь проводки и результат выдачи.</p></div></div><table><tbody>{% for name,count in checks.violations %}<tr><td>{{ name == 'financial' ? 'Деньги и проводки' : (name == 'paid_without_fulfillment' ? 'Оплаченные заказы без выдачи' : 'Активные подписки с истёкшим сроком') }}</td><td><span class="badge {{ count ? 'canceled' : 'fulfilled' }}">{{ count }} нарушений</span></td></tr>{% endfor %}</tbody></table><form method="post" action="/admin/intelligence/invariants"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button">Запустить проверку и создать кейсы</button></form></section>
<section class="panel detail"><div class="section-title"><span class="section-number">2</span><div><h2>Глобальный безопасный режим</h2><p>Новые оплаты записываются надёжно, а рискованные ручные действия и немедленная выдача VPN приостанавливаются.</p></div></div><form method="post" action="/admin/intelligence/safety-mode" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="enabled" value="{{ safety ? '0' : '1' }}"><button class="button {{ safety ? 'light' : '' }}">{{ safety ? 'Вернуть обычный режим' : 'Включить безопасный режим' }}</button></form></section>
<section class="panel detail"><div class="section-title"><span class="section-number">3</span><div><h2>Плановые работы</h2><p>Во время работ запросы выдачи остаются в надёжной очереди и будут обработаны после окна.</p></div></div><form method="post" action="/admin/intelligence/maintenance" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Сервис<select name="service"><option value="remnawave">Remnawave</option><option value="payments">Платёжные провайдеры</option><option value="worker">Фоновые обработчики</option></select></label><label>Начало<input name="starts_at" type="datetime-local" required></label><label>Окончание<input name="ends_at" type="datetime-local" required></label><label>Комментарий<input name="note" maxlength="300" required placeholder="Плановые работы"></label><button class="button small">Запланировать</button></form>{% if maintenance %}<table><thead><tr><th>Сервис</th><th>Окно</th><th>Комментарий</th></tr></thead><tbody>{% for m in maintenance %}<tr><td>{{ m.service }}</td><td>{{ m.starts_at|date('d.m H:i') }} — {{ m.ends_at|date('d.m H:i') }}</td><td>{{ m.note }}</td></tr>{% endfor %}</tbody></table>{% endif %}</section>
<section class="panel detail"><h2>Платёжные провайдеры за 24 часа</h2><table class="admin-data-table"><thead><tr><th>Провайдер</th><th>Всего</th><th>Успешно</th><th>Ошибки</th></tr></thead><tbody>{% for p in providers %}<tr><td data-label="Провайдер">{{ p.provider }}</td><td data-label="Всего">{{ p.total }}</td><td data-label="Успешно" class="positive">{{ p.succeeded }}</td><td data-label="Ошибки" class="{{ p.failed ? 'negative' : '' }}">{{ p.failed }}</td></tr>{% else %}<tr><td colspan="4">Данных пока нет.</td></tr>{% endfor %}</tbody></table></section>
<section class="panel detail"><h2>Автоматически созданные кейсы</h2><table class="admin-data-table"><thead><tr><th>Код</th><th>Критичность</th><th>Проблема</th><th>Создан</th></tr></thead><tbody>{% for c in cases %}<tr><td data-label="Код">{{ c.code }}</td><td data-label="Критичность"><span class="badge {{ c.severity in ['high','critical'] ? 'canceled' : 'pending' }}">{{ c.severity }}</span></td><td data-label="Проблема">{{ c.title }}</td><td data-label="Создан">{{ c.created_at|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="4">Открытых кейсов нет.</td></tr>{% endfor %}</tbody></table></section>
<section class="panel detail"><h2>Canary и центр миграций</h2><p>{% if canary %}Последний canary: <strong>{{ canary.status }}</strong> · этап {{ canary.stage }} · {{ canary.created_at|date('d.m.Y H:i') }}{% else %}Canary-аккаунты ещё не зарегистрировали прогон.{% endif %}</p><table class="admin-data-table"><thead><tr><th>Миграция</th><th>Источник</th><th>Статус</th><th>Drift</th></tr></thead><tbody>{% for m in migrations %}<tr><td data-label="Миграция">{{ m.name }}</td><td data-label="Источник">{{ m.source_name }}</td><td data-label="Статус">{{ m.status }}</td><td data-label="Drift">{{ m.drift_count }}</td></tr>{% else %}<tr><td colspan="4">Миграций ещё нет. Запускайте сначала dry-run и сохраняйте rollback plan.</td></tr>{% endfor %}</tbody></table></section>
{% endblock %}
