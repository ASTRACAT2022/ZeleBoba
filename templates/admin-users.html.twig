{% extends 'base.html.twig' %}{% block title %}Клиенты{% endblock %}{% block content %}<header><div><p class="eyebrow">АККАУНТЫ СЕРВИСА</p><h1>Ваши клиенты.</h1><p class="muted">Полное управление: профиль, баланс, подписки, скидки. Отключение закрывает вход и новые покупки.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Поиск</h2><form method="get" action="/admin/users/search" class="row-form"><label>Email, Telegram ID или реферальный код<input name="q" value="{{ query ?? '' }}" placeholder="example@mail.com или 123456789"></label><button class="button">Найти →</button></form></section><section class="panel"><div class="table-wrap"><table><thead><tr><th>Аккаунт</th><th>Telegram</th><th>Баланс</th><th>Доступ</th><th>Действие</th></tr></thead><tbody>{% for u in users %}<tr><td><a href="/admin/users/{{ u.id }}">{{ u.email ?? 'Telegram-аккаунт' }}</a><small>{{ u.role }}</small></td><td>{{ u.telegram_id ?? 'Не подключён' }}</td><td>{{ u.balance_kopeks|rub }}</td><td><span class="badge {{ u.disabled ? 'canceled' : 'fulfilled' }}">{{ u.disabled ? 'Отключён' : 'Активен' }}</span></td><td><a class="button light small" href="/admin/users/{{ u.id }}">Профиль</a>{% if u.role != 'admin' %} <form method="post" action="/admin/users/{{ u.id }}/toggle" class="inline-layout-1"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button secondary small">{{ u.disabled ? 'Включить' : 'Отключить' }}</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5">Никого не найдено.</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
