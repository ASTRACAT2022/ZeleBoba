{% extends 'base.html.twig' %}{% block title %}Клиенты{% endblock %}{% block content %}<header><div><p class="eyebrow">АККАУНТЫ СЕРВИСА</p><h1>Ваши клиенты.</h1><p class="muted">Последние 100 аккаунтов. Отключение закрывает вход в кабинет и новые покупки; действующий VPN-доступ не отзывается.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel"><div class="table-wrap"><table><thead><tr><th>Аккаунт</th><th>Telegram</th><th>Доступ</th><th>Действие</th></tr></thead><tbody>{% for u in users %}<tr><td>{{ u.email ?? 'Telegram-аккаунт' }}<small>{{ u.role }}</small></td><td>{{ u.telegram_id ?? 'Не подключён' }}</td><td><span class="badge {{ u.disabled ? 'canceled' : 'fulfilled' }}">{{ u.disabled ? 'Отключён' : 'Активен' }}</span></td><td>{% if u.role != 'admin' %}<form method="post" action="/admin/users/{{ u.id }}/toggle"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button secondary small">{{ u.disabled ? 'Включить' : 'Отключить вход' }}</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
