{% extends 'base.html.twig' %}{% block title %}Баланс{% endblock %}{% block content %}<header><div><p class="eyebrow">КОШЕЛЁК</p><h1>Баланс.</h1><p class="muted">Пополняйте любым способом и покупайте подписки с баланса.</p></div><div class="price">{{ balance|rub }}</div></header><section class="panel detail"><h2>Пополнить баланс</h2><form method="post" action="/balance/topup" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="idempotency_key" value="{{ key }}"><label>Сумма, ₽<input type="number" name="amount" min="1" max="1000000" step="1" required placeholder="500"></label><label>Способ оплаты<select name="provider">{% for id, name in providers %}<option value="{{ id }}">{{ name }}</option>{% endfor %}</select></label><button class="button">Пополнить →</button></form>{% if topups %}<h2>Последние пополнения</h2><table><thead><tr><th>Сумма</th><th>Статус</th><th>Дата</th></tr></thead><tbody>{% for t in topups %}<tr><td>{{ t.amount_kopeks|rub }}</td><td>{{ t.status == 'pending' ? 'Ожидает оплаты' : (t.status == 'paid' ? 'Зачислено' : 'Отменено') }}</td><td>{{ t.created_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% endif %}</section><section class="panel detail"><h2>История операций</h2>{% if history %}<table><thead><tr><th>Операция</th><th>Сумма</th><th>Дата</th></tr></thead><tbody>{% for t in history %}<tr><td>{{ t.description ?? t.type }}</td><td class="{{ t.amount_kopeks > 0 ? 'positive' : 'negative' }}">{{ t.amount_kopeks > 0 ? '+' : '' }}{{ t.amount_kopeks|rub }}</td><td>{{ t.created_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Операций пока нет.</p>{% endif %}</section>{% endblock %}
