{% extends 'base.html.twig' %}{% block title %}Creators{% endblock %}{% block content %}{% include '_admin-nav.html.twig' %}<header><div><p class="eyebrow">ADMIN · CREATORS</p><h1>Партнёры</h1><p class="muted">Финансовые данные считаются по неизменяемому ledger.</p></div></header><section class="panel detail"><table><thead><tr><th>Имя</th><th>Код</th><th>Статус</th><th>Заработано</th></tr></thead><tbody>{% for c in creators %}<tr><td>{{ c.name }}</td><td>{{ c.code }}</td><td>{{ c.status }}</td><td>{{ c.earned|rub }}</td></tr>{% else %}<tr><td colspan="4" class="muted">Партнёры ещё не созданы миграцией или админ-операцией.</td></tr>{% endfor %}</tbody></table><p><a class="button secondary" href="/admin/creators/reconciliation">Reconciliation →</a></p></section>{% endblock %}
