{% extends 'base.html.twig' %}{% block title %}{{ mode == 'login' ? 'Вход' : 'Регистрация' }}{% endblock %}{% block content %}<section class="auth-card"><a class="brand" href="/"><span class="logo">z</span>{{ site_name }}</a><p class="eyebrow">ВАШЕ ПОДКЛЮЧЕНИЕ НАЧИНАЕТСЯ ЗДЕСЬ</p><h1>{{ mode == 'login' ? 'С возвращением.' : 'Создайте аккаунт.' }}</h1><p class="muted">Подписки, оплата и доступ — в одном кабинете.</p>{% if telegram_enabled %}<form method="post" action="/telegram/start"><input type="hidden" name="_csrf" value="{{ guest_csrf }}"><button class="button full telegram-button">Войти через Telegram ↗</button></form><div class="auth-divider">или по электронной почте</div>{% endif %}<form method="post"><input type="hidden" name="_csrf" value="{{ guest_csrf }}"><label>Электронная почта<input type="email" name="email" required maxlength="254" autocomplete="email" placeholder="you@example.com"></label><label>Пароль<input type="password" name="password" required minlength="{{ mode == 'register' ? 12 : 1 }}" maxlength="128" autocomplete="{{ mode == 'login' ? 'current-password' : 'new-password' }}" placeholder="{{ mode == 'register' ? 'Не менее 12 символов' : 'Введите пароль' }}"></label>{% if mode == 'login' %}<label>Код 2FA, если включена<input name="code" autocomplete="one-time-code" maxlength="16" placeholder="Код приложения или резервный код"></label>{% endif %}<button class="button full">{{ mode == 'login' ? 'Войти в кабинет →' : 'Создать аккаунт →' }}</button></form><p>{{ mode == 'login' ? 'Ещё нет аккаунта?' : 'Уже зарегистрированы?' }} <a href="/{{ mode == 'login' ? 'register' : 'login' }}">{{ mode == 'login' ? 'Зарегистрироваться' : 'Войти' }}</a></p></section>{% endblock %}
