{% extends 'base.html.twig' %}{% block title %}{{ mode == 'login' ? 'Вход' : (mode == 'register' ? 'Регистрация' : (mode == 'forgot' or mode == 'forgot-done' ? 'Восстановление пароля' : 'Новый пароль')) }}{% endblock %}{% block content %}
<section class="auth-card">
  <a class="brand" href="/">{% if logo %}<img class="logo-img" src="{{ logo }}" alt="">{% else %}<span class="brand-mark" aria-hidden="true">A</span>{% endif %}<span>{{ site_name }}</span></a>

  {% if mode == 'forgot-done' %}
    <p class="eyebrow">Восстановление</p>
    <h1>Проверьте почту</h1>
    <p class="muted">Если аккаунт с таким email существует, мы отправили ссылку для восстановления пароля (действительна 24 часа).</p>
    <p><a href="/login">← Вернуться ко входу</a></p>

  {% elseif mode == 'reset-done' %}
    <p class="eyebrow">Готово</p>
    <h1>Пароль изменён</h1>
    <p class="muted">Теперь войдите с новым паролем.</p>
    <p><a href="/login">Войти в кабинет →</a></p>

  {% elseif mode == 'forgot' %}
    <p class="eyebrow">Восстановление</p>
    <h1>Забыли пароль?</h1>
    <p class="muted">Укажите email — пришлём ссылку для сброса.</p>
    <form method="post">
      <input type="hidden" name="_csrf" value="{{ guest_csrf }}">
      <label>Электронная почта<input type="email" name="email" required maxlength="254" autocomplete="email" placeholder="you@example.com"></label>
      <button class="button full">Отправить ссылку</button>
    </form>
    <p><a href="/login">← Вернуться ко входу</a></p>

  {% elseif mode == 'reset' %}
    <p class="eyebrow">Новый пароль</p>
    <h1>Задайте новый пароль</h1>
    <p class="muted">Минимум 12 символов.</p>
    <form method="post">
      <input type="hidden" name="_csrf" value="{{ guest_csrf }}">
      <label>Новый пароль<input type="password" name="password" required minlength="12" maxlength="128" autocomplete="new-password" placeholder="Не менее 12 символов"></label>
      <button class="button full">Сохранить пароль</button>
    </form>

  {% else %}
    <p class="eyebrow">Личный кабинет</p>
    <h1>{{ mode == 'login' ? 'Вход в кабинет' : 'Создайте аккаунт' }}</h1>
    <p class="muted">Подписки, оплата и доступ — в одном месте.</p>

    {% if telegram_enabled %}
    <form method="post" action="/telegram/start">
      <input type="hidden" name="_csrf" value="{{ guest_csrf }}">
      <button class="button full telegram-button">Войти через Telegram ↗</button>
    </form>
    <div class="auth-divider">или по электронной почте</div>
    {% endif %}

    <form method="post" id="magic-login">
      <input type="hidden" name="_csrf" value="{{ guest_csrf }}">
      <input type="hidden" name="token" value="">
      <label>Электронная почта<input type="email" name="email" required maxlength="254" autocomplete="email" placeholder="you@example.com"></label>
      <label>Пароль<input type="password" name="password" required minlength="{{ mode == 'register' ? 12 : 1 }}" maxlength="128" autocomplete="{{ mode == 'login' ? 'current-password' : 'new-password' }}" placeholder="{{ mode == 'register' ? 'Не менее 12 символов' : 'Введите пароль' }}"></label>
      {% if mode == 'login' %}<label>Код 2FA, если включена<input name="code" autocomplete="one-time-code" maxlength="16" placeholder="Код приложения или резервный код"></label>{% endif %}
      <button class="button full">{{ mode == 'login' ? 'Войти' : 'Создать аккаунт' }}</button>
    </form>

    {% if mode == 'login' %}<p><a href="/forgot">Забыли пароль?</a></p>{% endif %}
    <p>{{ mode == 'login' ? 'Ещё нет аккаунта?' : 'Уже зарегистрированы?' }} <a href="/{{ mode == 'login' ? 'register' : 'login' }}">{{ mode == 'login' ? 'Зарегистрироваться' : 'Войти' }}</a></p>
  {% endif %}
</section>
{% endblock %}
