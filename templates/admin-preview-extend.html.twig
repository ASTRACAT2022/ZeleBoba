{% extends 'base.html.twig' %}{% block title %}Preview extension{% endblock %}{% block content %}<header><h1>Preview: продление на {{ months }} мес.</h1></header><section class="panel detail"><h2>Ничего ещё не изменено</h2><p>BEFORE: expires_at <strong>{{ sub.expires_at|date('d.m.Y H:i') }}</strong></p><p>AFTER: expires_at <strong>{{ after|date('d.m.Y H:i') }}</strong></p><p>Remnawave после подтверждённого изменения получит PATCH <code>expireAt={{ after|date('c') }}</code> через outbox.</p></section>{% endblock %}
