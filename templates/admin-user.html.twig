{% extends 'base.html.twig' %}{% block title %}Пользователь{% endblock %}{% block content %}<header><div><p class="eyebrow">УПРАВЛЕНИЕ КЛИЕНТОМ</p><h1>{{ profile.user.email ?? ('TG ' ~ profile.user.telegram_id) }}</h1><p class="muted">Полный профиль: баланс, подписки, заказы, скидки.</p></div><a class="button light" href="/admin/users">← К списку клиентов</a></header>{% include '_admin-nav.html.twig' %}<section class="panel detail investigation-tools"><div><h2>Расследование без риска</h2><p class="muted">Посмотрите состояние на конкретную дату или смоделируйте изменение без записи в базу.</p></div><form method="get" action="/admin/users/{{ profile.user.id }}/state-at" class="row-form"><label>Состояние на дату<input type="datetime-local" name="at" required></label><button class="button small">Открыть снимок</button></form><form method="get" action="/admin/users/{{ profile.user.id }}/simulate" class="row-form"><label>Тариф для симуляции<select name="plan_id">{% for p in plans %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}</select></label><label>Скидка, %<input type="number" name="promo" min="0" max="99" value="0"></label><button class="button secondary small">Смоделировать</button></form></section>
<div class="overview">
<section class="connection"><div class="section-top"><span>ПРОФИЛЬ</span><span class="connection-icon">↗</span></div><div class="connection-empty"><h2>{{ profile.user.email ?? 'Telegram-аккаунт' }}</h2><p>ID: {{ profile.user.id|slice(0,8) }} · Роль: {{ profile.user.role }} · Регистрация: {{ profile.user.created_at|date('d.m.Y') }}</p><p>Баланс: <strong>{{ profile.user.balance_kopeks|rub }}</strong> · Потрачено всего: {{ (profile.spent_kopeks / 100)|round(0, 'floor') }} ₽</p>{% if profile.user.promo_offer_discount_percent > 0 %}<p>Скидка: <strong>{{ profile.user.promo_offer_discount_percent }}%</strong>{% if profile.user.promo_offer_discount_expires_at %} до {{ profile.user.promo_offer_discount_expires_at|date('d.m.Y H:i') }}{% endif %}</p>{% endif %}{% if profile.referrer %}<p>Приглашён: {{ profile.referrer.email ?? ('TG ' ~ profile.referrer.telegram_id) }}</p>{% endif %}<p>Рефералов: {{ profile.referrals|length }}</p></div></section>
<section class="side-card"><div class="tile-icon">⚙</div><h2>Действия</h2><p>Корректировка баланса, начисление дней, скидки.</p><div class="separator"></div><form method="post" action="/admin/users/{{ profile.user.id }}/balance" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Баланс, ₽<input type="number" name="amount" step="1" placeholder="+500 или -200"></label><label>Причина<input name="reason" required maxlength="200" placeholder="Компенсация"></label><button class="button small">Применить</button></form><div class="separator"></div><form method="post" action="/admin/users/{{ profile.user.id }}/days" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Дней подписки<input type="number" name="days" min="1" max="3650" required></label><label>Тариф (для новой)<select name="plan_id"><option value="">—</option>{% for p in plans %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}</select></label><button class="button small">Начислить</button></form><div class="separator"></div><form method="post" action="/admin/users/{{ profile.user.id }}/discount" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Скидка, %<input type="number" name="percent" min="1" max="99" required></label><label>Часов действия<input type="number" name="hours" min="0" value="24"></label><button class="button small">Установить</button></form>{% if profile.user.promo_offer_discount_percent > 0 %}<form method="post" action="/admin/users/{{ profile.user.id }}/discount/clear"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button light small">Снять скидку</button></form>{% endif %}</section>
</div>
<section class="panel detail"><h2>Creator Program</h2>{% if creator %}<p><strong>Status:</strong> {{ creator.status }} · <strong>Code:</strong> <code>{{ creator.code }}</code></p>{% else %}<p class="muted">Creator Mode выключен. Профиль создаётся для этого существующего пользователя без новой роли или входа.</p>{% endif %}<form method="post" action="/admin/users/{{ profile.user.id }}/creator" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Creator code<input name="code" value="{{ creator.code ?? ('CAT-' ~ profile.user.id|slice(0,6)|upper) }}" required></label><label>Первая, %<input type="number" name="first_percent" min="0" max="100" value="{{ creator.first_percent ?? 10 }}"></label><label>Продления, %<input type="number" name="recurring_percent" min="0" max="100" value="{{ creator.recurring_percent ?? 5 }}"></label><label>Срок, дней<input type="number" name="recurring_days" value="{{ creator.recurring_days ?? 180 }}"></label><label>Attribution, дней<input type="number" name="attribution_days" value="{{ creator.attribution_days ?? 30 }}"></label><label>Hold, дней<input type="number" name="hold_days" value="{{ creator.hold_days ?? 14 }}"></label><button class="button">{{ creator ? (creator.status == 'suspended' ? 'Активировать' : 'Сохранить') : 'Сделать Creator' }}</button></form>{% if creator and creator.status == 'active' %}<form method="post" action="/admin/users/{{ profile.user.id }}/creator/suspend"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button light small">Отключить Creator Mode</button></form>{% endif %}</section>
<section class="panel detail"><h2>Подписки</h2>{% if sub_removed %}<p class="notice">Подписка удалена из кабинета и Remnawave.</p>{% endif %}{% if profile.subscriptions %}<table><thead><tr><th>Тариф</th><th>Статус</th><th>До</th><th>Трафик</th><th>Устройства</th><th>Триал</th><th></th></tr></thead><tbody>{% for s in profile.subscriptions %}<tr><td><a href="/admin/subscriptions/{{ s.id }}">{{ s.plan_name ?? '—' }}</a></td><td><span class="badge {{ s.status == 'active' and s.expires_at > now ? 'fulfilled' : 'pending' }}">{{ s.status }}</span></td><td>{{ s.expires_at|date('d.m.Y H:i') }}</td><td>{{ s.traffic_used_gb }} / {{ s.traffic_limit_gb == 0 ? '∞' : s.traffic_limit_gb }} ГБ</td><td>{{ s.device_limit == 0 ? 'Безлимит' : s.device_limit }}</td><td>{{ s.is_trial ? 'Да' : 'Нет' }}</td><td>{% if s.status == 'active' or s.status == 'trial' %}<form method="post" action="/admin/users/{{ profile.user.id }}/subscriptions/{{ s.id }}/remove" data-confirm="Удалить эту подписку? VPN-доступ будет удалён из Remnawave, клиент потеряет доступ."><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button small">Удалить</button></form>{% endif %}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Подписок нет.</p>{% endif %}</section>
<section class="panel detail"><h2>Хронология клиента</h2>{% if profile.timeline %}<ol class="customer-timeline">{% for event in profile.timeline %}<li><time>{{ event.occurred_at|date('H:i') }}</time><span>{% if event.event_type == 'payment.created' %}Payment created — {{ event.payload.amount_kopeks|rub }}{% elseif event.event_type == 'payment.paid' %}Payment paid{% elseif event.event_type == 'subscription.renewed' %}Subscription renewed → {{ event.payload.expires_at|date('d M') }}{% elseif event.event_type == 'vpn.provisioning_started' %}VPN provisioning started{% elseif event.event_type == 'vpn.resource_updated' %}VPN resource updated{% elseif event.event_type == 'subscription.active' %}Subscription ACTIVE{% elseif event.event_type == 'telegram.notification_delivered' %}Telegram notification delivered{% else %}{{ event.event_type }}{% endif %}</span></li>{% endfor %}</ol>{% else %}<p class="muted">Событий пока нет.</p>{% endif %}</section>
<section class="panel detail"><h2>Заказы</h2>{% if profile.orders %}<table><thead><tr><th>Тариф</th><th>Сумма</th><th>Статус</th><th>Провайдер</th><th>Дата</th></tr></thead><tbody>{% for o in profile.orders %}<tr><td>{{ o.plan_name }}</td><td>{{ o.price_minor|rub }}</td><td><span class="badge {{ o.status == 'fulfilled' ? 'fulfilled' : (o.status == 'pending' ? 'pending' : 'canceled') }}">{{ o.status }}</span></td><td>{{ o.provider }}</td><td>{{ o.created_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Заказов нет.</p>{% endif %}</section>
<section class="panel detail"><h2>Пополнения</h2>{% if profile.topups %}<table><thead><tr><th>Сумма</th><th>Статус</th><th>Провайдер</th><th>Дата</th></tr></thead><tbody>{% for t in profile.topups %}<tr><td>{{ t.amount_kopeks|rub }}</td><td><span class="badge {{ t.status == 'paid' ? 'fulfilled' : 'pending' }}">{{ t.status }}</span></td><td>{{ t.provider }}</td><td>{{ t.created_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Пополнений нет.</p>{% endif %}</section>
<section class="panel detail"><h2>История операций</h2>{% if profile.transactions %}<table><thead><tr><th>Операция</th><th>Сумма</th><th>Дата</th></tr></thead><tbody>{% for t in profile.transactions %}<tr><td>{{ t.description ?? t.type }}</td><td class="{{ t.amount_kopeks > 0 ? 'positive' : 'negative' }}">{{ t.amount_kopeks > 0 ? '+' : '' }}{{ t.amount_kopeks|rub }}</td><td>{{ t.created_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Операций нет.</p>{% endif %}</section>
<section class="panel detail"><h2>Промокоды и подарки</h2>{% if profile.promo_uses %}<table><thead><tr><th>Код</th><th>Тип</th><th>Дата</th></tr></thead><tbody>{% for p in profile.promo_uses %}<tr><td>{{ p.code }}</td><td>{{ p.type }}</td><td>{{ p.used_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Промокоды не использовались.</p>{% endif %}{% if profile.gifts %}<h2>Купленные подарки</h2><table><thead><tr><th>Дней</th><th>Статус</th><th>Дата</th></tr></thead><tbody>{% for g in profile.gifts %}<tr><td>{{ g.period_days }}</td><td><span class="badge {{ g.status == 'delivered' ? 'fulfilled' : 'pending' }}">{{ g.status }}</span></td><td>{{ g.created_at|date('d.m.Y') }}</td></tr>{% endfor %}</tbody></table>{% endif %}</section>
<section class="panel detail"><h2>Последние действия</h2>{% if recentActivity %}<table><thead><tr><th>Time</th><th>Type</th><th>Operation</th><th>Status</th><th>Duration</th></tr></thead><tbody>{% for a in recentActivity %}<tr><td>{{ (a.started_at|date('H:i:s')) }}</td><td>{{ a.type }}</td><td><a href="/admin/operations/{{ a.id }}">{{ a.id }}</a></td><td><span class="badge {{ a.status == 'success' ? 'fulfilled' : (a.status == 'failed' ? 'canceled' : 'pending') }}">{{ a.status }}</span></td><td>{{ a.duration_ms ? a.duration_ms ~ ' ms' : '—' }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Недавних действий нет.</p>{% endif %}</section>
{% endblock %}
