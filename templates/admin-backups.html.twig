{% extends 'base.html.twig' %}{% block title %}Бэкапы{% endblock %}{% block content %}<header><div><p class="eyebrow">ЭКСПЛУАТАЦИЯ</p><h1>Бэкапы.</h1><p class="muted">Создание и восстановление резервных копий БД.</p></div></header><section class="panel detail"><h2>Создать бэкап</h2><form method="post" action="/admin/backups"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button">Создать бэкап →</button></form><p class="muted">Бэкап сохраняется в var/backups. Восстановление перезаписывает текущую БД.</p></section><section class="panel detail"><h2>Бэкапы</h2>{% if backups %}<table><thead><tr><th>Файл</th><th>Размер</th><th>Дата</th><th></th></tr></thead><tbody>{% for b in backups %}<tr><td>{{ b.file }}</td><td>{{ (b.size / 1024)|round(0) }} КБ</td><td>{{ b.created_at|date('d.m.Y H:i') }}</td><td><form method="post" action="/admin/backups/{{ b.file }}/restore" onsubmit="return confirm('Восстановить этот бэкап? Текущие данные будут перезаписаны.');"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button light small">Восстановить</button></form></td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Бэкапов пока нет.</p>{% endif %}</section>{% endblock %}
