{% extends 'base.html.twig' %}{% block title %}Incidents{% endblock %}{% block content %}<header><h1>Incidents</h1></header><section class="panel detail"><form method="post" action="/admin/incidents" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Incident<input name="title" required maxlength="200" placeholder="Remnawave outage"></label><button class="button">Create incident</button></form></section><section class="panel detail"><table><thead><tr><th>ID</th><th>Title</th><th>Status</th><th>Affected operations</th></tr></thead><tbody>{% for i in incidents %}<tr><td>{{ i.code }}</td><td>{{ i.title }}</td><td>{{ i.status }}</td><td>{{ i.affected }}</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
