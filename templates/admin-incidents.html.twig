{% extends 'base.html.twig' %}{% block title %}Инциденты{% endblock %}{% block content %}<header><div><p class="eyebrow">ОПЕРАЦИОННЫЙ ЦЕНТР</p><h1>Инциденты.</h1><p class="muted">Фиксируйте сбои, чтобы видеть затронутые операции и ход восстановления.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><form method="post" action="/admin/incidents" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Название инцидента<input name="title" required maxlength="200" placeholder="Недоступность Remnawave"></label><button class="button">Создать инцидент</button></form></section><section class="panel detail"><table><thead><tr><th>Код</th><th>Название</th><th>Статус</th><th>Затронутые операции</th></tr></thead><tbody>{% for i in incidents %}<tr><td>{{ i.code }}</td><td>{{ i.title }}</td><td>{{ i.status }}</td><td>{{ i.affected }}</td></tr>{% else %}<tr><td colspan="4">Открытых инцидентов нет.</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
