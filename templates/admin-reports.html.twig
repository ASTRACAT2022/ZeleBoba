{% extends 'base.html.twig' %}{% block title %}Отчёты{% endblock %}{% block content %}<header><div><p class="eyebrow">АНАЛИТИКА</p><h1>Отчёты.</h1><p class="muted">Продажи, выручка, реферальная сеть.</p></div></header><section class="panel detail"><h2>За 30 дней</h2><table><thead><tr><th>Показатель</th><th>Значение</th></tr></thead><tbody><tr><td>Выручка</td><td>{{ (stats.revenue_kopeks / 100)|round(0, 'floor') }} ₽</td></tr><tr><td>Заказы</td><td>{{ stats.orders }}</td></tr><tr><td>Пополнения</td><td>{{ stats.topups }}</td></tr><tr><td>Новые пользователи</td><td>{{ stats.new_users }}</td></tr><tr><td>Активные подписки</td><td>{{ stats.active_subscriptions }} (триалов: {{ stats.active_trials }})</td></tr></tbody></table></section><section class="panel detail"><h2>Выручка по дням</h2><table><thead><tr><th>День</th><th>Выручка</th></tr></thead><tbody>{% for day, total in daily %}<tr><td>{{ day }}</td><td>{{ (total / 100)|round(0, 'floor') }} ₽</td></tr>{% endfor %}</tbody></table></section>{% if top %}<section class="panel detail"><h2>Топ рефереров</h2><table><thead><tr><th>Реферер</th><th>Заработано</th><th>Рефералов</th></tr></thead><tbody>{% for r in top %}<tr><td>{{ r.email ?? ('TG ' ~ r.telegram_id) }}</td><td>{{ (r.total / 100)|round(0, 'floor') }} ₽</td><td>{{ r.referrals }}</td></tr>{% endfor %}</tbody></table></section>{% endif %}{% endblock %}
