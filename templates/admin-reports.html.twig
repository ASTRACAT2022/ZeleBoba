{% extends 'base.html.twig' %}{% block title %}Отчёты{% endblock %}{% block content %}<header><div><p class="eyebrow">АНАЛИТИКА</p><h1>Отчёты.</h1><p class="muted">Детальная аналитика заработка: выручка, структура, топ клиентов.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Период</h2><form method="post" action="/admin/reports" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Дней<select name="days"><option value="7" {{ days == 7 ? 'selected' : '' }}>7</option><option value="30" {{ days == 30 ? 'selected' : '' }}>30</option><option value="90" {{ days == 90 ? 'selected' : '' }}>90</option><option value="365" {{ days == 365 ? 'selected' : '' }}>365</option></select></label><button class="button">Показать →</button></form></section>
<section class="panel detail"><h2>Ключевые показатели ({{ days }} дн.)</h2><table><thead><tr><th>Показатель</th><th>Значение</th></tr></thead><tbody><tr><td>Выручка</td><td><strong>{{ (stats.revenue_kopeks / 100)|round(0, 'floor') }} ₽</strong></td></tr><tr><td>Средний чек</td><td>{{ (stats.avg_check_kopeks / 100)|round(0, 'floor') }} ₽</td></tr><tr><td>Заказы</td><td>{{ stats.orders }}</td></tr><tr><td>Пополнения</td><td>{{ stats.topups }}</td></tr><tr><td>Подарки</td><td>{{ stats.gifts }}</td></tr><tr><td>Новые пользователи</td><td>{{ stats.new_users }}</td></tr><tr><td>Конверсия в покупку</td><td>{{ stats.conversion_percent }}%</td></tr><tr><td>Активные подписки</td><td>{{ stats.active_subscriptions }} (триалов: {{ stats.active_trials }})</td></tr></tbody></table></section>
<section class="panel detail"><h2>Структура выручки</h2><table><thead><tr><th>Источник</th><th>Сумма</th></tr></thead><tbody><tr><td>Пополнения баланса</td><td>{{ (by_type.topups_kopeks / 100)|round(0, 'floor') }} ₽</td></tr><tr><td>Покупки подписок</td><td>{{ (by_type.purchases_kopeks / 100)|round(0, 'floor') }} ₽</td></tr><tr><td>Подарки</td><td>{{ (by_type.gifts_kopeks / 100)|round(0, 'floor') }} ₽</td></tr><tr><td>Докупки (трафик/устройства)</td><td>{{ (by_type.addons_kopeks / 100)|round(0, 'floor') }} ₽</td></tr></tbody></table></section>
<section class="panel detail"><h2>Выручка по провайдерам</h2>{% if by_provider %}<table><thead><tr><th>Провайдер</th><th>Заказов</th><th>Сумма</th></tr></thead><tbody>{% for p in by_provider %}<tr><td>{{ p.provider }}</td><td>{{ p.cnt }}</td><td>{{ (p.total / 100)|round(0, 'floor') }} ₽</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Нет данных.</p>{% endif %}</section>
<section class="panel detail"><h2>Выручка по тарифам</h2>{% if by_plan %}<table><thead><tr><th>Тариф</th><th>Заказов</th><th>Сумма</th></tr></thead><tbody>{% for p in by_plan %}<tr><td>{{ p.plan_name }}</td><td>{{ p.cnt }}</td><td>{{ (p.total / 100)|round(0, 'floor') }} ₽</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Нет данных.</p>{% endif %}</section>
<section class="panel detail"><h2>Выручка по дням</h2><table><thead><tr><th>День</th><th>Выручка</th></tr></thead><tbody>{% for day, total in daily %}<tr><td>{{ day }}</td><td>{{ (total / 100)|round(0, 'floor') }} ₽</td></tr>{% endfor %}</tbody></table></section>
{% if top_customers %}<section class="panel detail"><h2>Топ клиентов по тратам</h2><table><thead><tr><th>Клиент</th><th>Потрачено</th><th></th></tr></thead><tbody>{% for c in top_customers %}<tr><td>{{ c.email ?? ('TG ' ~ c.telegram_id) }}</td><td>{{ (c.spent / 100)|round(0, 'floor') }} ₽</td><td><a class="button light small" href="/admin/users/{{ c.id }}">Профиль</a></td></tr>{% endfor %}</tbody></table></section>{% endif %}
{% if top %}<section class="panel detail"><h2>Топ рефереров</h2><table><thead><tr><th>Реферер</th><th>Заработано</th><th>Рефералов</th></tr></thead><tbody>{% for r in top %}<tr><td>{{ r.email ?? ('TG ' ~ r.telegram_id) }}</td><td>{{ (r.total / 100)|round(0, 'floor') }} ₽</td><td>{{ r.referrals }}</td></tr>{% endfor %}</tbody></table></section>{% endif %}{% endblock %}
