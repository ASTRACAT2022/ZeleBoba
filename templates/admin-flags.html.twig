{% extends 'base.html.twig' %}{% block title %}Настройки запуска{% endblock %}{% block content %}<header><div><p class="eyebrow">УПРАВЛЕНИЕ СИСТЕМОЙ</p><h1>Настройки запуска и аварийные переключатели.</h1><p class="muted">Изменения применяются сразу. Отключение provisioning не отменяет уже принятые платежи — они останутся в очереди до восстановления.</p></div><a class="button light" href="/">← Вернуться в личный кабинет</a></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><table><thead><tr><th>Функция</th><th>Состояние</th><th>Охват</th><th></th></tr></thead><tbody>{% for f in flags %}{% set labels = {'notifications.telegram':'Уведомления в Telegram','provisioning.enabled':'Выдача и синхронизация VPN','reconciliation.auto_heal':'Автоматическое исправление рассинхронизации'} %}{% set descriptions = {'notifications.telegram':'Отправка сервисных сообщений пользователям','provisioning.enabled':'Аварийный стоп для запросов к Remnawave','reconciliation.auto_heal':'Исправлять только однозначные расхождения Billing ↔ Remnawave'} %}<tr><td><form id="flag-{{ loop.index }}" method="post" action="/admin/flags"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="name" value="{{ f.name }}"></form><strong>{{ labels[f.name] ?? f.name }}</strong><br><small>{{ descriptions[f.name] ?? 'Системная настройка' }}</small></td><td><select name="enabled" form="flag-{{ loop.index }}"><option value="1" {{ f.enabled ? 'selected' : '' }}>Включено</option><option value="0" {{ not f.enabled ? 'selected' : '' }}>Выключено</option></select></td><td><input name="rollout" form="flag-{{ loop.index }}" type="number" min="0" max="100" value="{{ f.rollout_percent }}">%<br><small>Доля пользователей, для которых включена функция</small></td><td><button class="button small" form="flag-{{ loop.index }}">Сохранить</button></td></tr>{% else %}<tr><td colspan="4">Настроек пока нет.</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
