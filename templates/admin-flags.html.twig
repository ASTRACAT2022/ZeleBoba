{% extends 'base.html.twig' %}{% block title %}Feature flags{% endblock %}{% block content %}<header><h1>Feature flags & kill switches</h1></header><section class="panel detail"><table><thead><tr><th>Flag</th><th>State</th><th>Rollout</th><th></th></tr></thead><tbody>{% for f in flags %}<tr><form method="post" action="/admin/flags"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><td>{{ f.name }}<input type="hidden" name="name" value="{{ f.name }}"></td><td><select name="enabled"><option value="1" {{ f.enabled ? 'selected' : '' }}>ON</option><option value="0" {{ not f.enabled ? 'selected' : '' }}>OFF</option></select></td><td><input name="rollout" type="number" min="0" max="100" value="{{ f.rollout_percent }}">%</td><td><button class="button small">Save</button></td></form></tr>{% else %}<tr><td colspan="4">Флаги ещё не созданы. Создайте через API/миграцию.</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
