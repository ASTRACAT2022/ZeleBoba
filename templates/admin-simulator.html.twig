{% extends 'base.html.twig' %}{% block title %}Симуляция изменения{% endblock %}{% block content %}<header><div><p class="eyebrow">WHAT-IF СИМУЛЯТОР</p><h1>Результат без записи в БД.</h1><p class="muted">Это безопасный расчёт. Подписка, баланс и очередь событий не изменены.</p></div><a class="button light" href="/admin/users/{{ user_id }}">← Карточка клиента</a></header>{% include '_admin-nav.html.twig' %}<section class="simulation"><article><small>Сейчас</small><p>Баланс <strong>{{ result.balance_minor|rub }}</strong></p><p>Подписка до <strong>{{ result.subscription_before ? result.subscription_before.expires_at|date('d.m.Y H:i') : 'нет' }}</strong></p></article><div class="simulation-arrow">→</div><article class="{{ result.sufficient ? 'simulation-ok' : 'simulation-warn' }}"><small>Если применить</small><p>{{ result.plan.name }} · скидка {{ result.promo_percent }}%</p><p>Списание <strong>{{ result.charge_minor|rub }}</strong></p><p>Баланс после <strong>{{ result.balance_after_minor|rub }}</strong></p><p>{% if result.sufficient %}Подписка до <strong>{{ result.expires_after|date('d.m.Y H:i') }}</strong>{% else %}<strong>Недостаточно средств — подписка не изменится</strong>{% endif %}</p></article></section>{% endblock %}
