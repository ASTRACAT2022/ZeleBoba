{% extends 'base.html.twig' %}{% block title %}{{ case.code }}{% endblock %}{% block content %}<header><div><p class="eyebrow">РАБОЧЕЕ ПРОСТРАНСТВО</p><h1>{{ case.title }}</h1><p class="muted">{{ case.code }} · {{ case.subject_type }}: {{ case.subject_id }}</p></div><a class="button light" href="/admin/investigations">← Все расследования</a></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Собранный контекст</h2>{% if case.context.subscription is defined and case.context.subscription %}<p>Подписка: <strong>{{ case.context.subscription.id }}</strong> · {{ case.context.subscription.plan_name ?? '—' }}</p>{% endif %}{% if case.context.user is defined and case.context.user %}<p>Клиент: {{ case.context.user.email ?? ('TG ' ~ case.context.user.telegram_id) }}</p>{% endif %}{% if case.context.payment is defined and case.context.payment %}<p>Платёж: {{ case.context.payment.amount_minor|rub }} · {{ case.context.payment.status }}</p>{% endif %}{% if case.context.incident is defined and case.context.incident %}<p>Инцидент: {{ case.context.incident.code }} · {{ case.context.incident.status }}</p>{% endif %}</section><section class="panel detail"><h2>Внутренние заметки</h2><ol class="customer-timeline">{% for n in case.notes %}<li><time>{{ n.created_at|date('H:i') }}</time><span>{{ n.body }}<br><small>{{ n.email ?? 'Оператор' }}</small></span></li>{% else %}<li><span>Добавьте первую заметку: что проверили и к какому выводу пришли.</span></li>{% endfor %}</ol>{% if case.status == 'open' %}<form method="post" action="/admin/investigations/{{ case.id }}/notes" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Заметка<input name="body" required maxlength="2000" placeholder="Например: нашли рассинхронизацию срока, запросили повторную выдачу."></label><button class="button">Сохранить</button></form><form method="post" action="/admin/investigations/{{ case.id }}/resolve"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button secondary">Закрыть расследование</button></form>{% endif %}</section>{% endblock %}
