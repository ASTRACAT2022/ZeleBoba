{% extends 'base.html.twig' %}{% block title %}Реферальная программа{% endblock %}{% block content %}<header><div><p class="eyebrow">ПАРТНЁРСКАЯ ПРОГРАММА</p><h1>Приглашайте друзей.</h1><p class="muted">Получайте комиссию с пополнений приглашённых.</p></div><div class="price">{{ (stats.earnings_kopeks / 100)|round(0, 'floor') }} ₽</div></header><section class="panel detail"><h2>Ваша ссылка</h2><p>Отправьте другу ссылку — при регистрации он станет вашим рефералом:</p><code class="token">https://t.me/{{ telegram_username }}?start=ref_{{ stats.code }}</code><p class="muted">Или код: <strong>{{ stats.code }}</strong></p></section><section class="panel detail"><h2>Статистика</h2><table><thead><tr><th>Показатель</th><th>Значение</th></tr></thead><tbody><tr><td>Приглашено</td><td>{{ stats.referrals|length }}</td></tr><tr><td>Оплативших</td><td>{{ stats.paid_referrals }}</td></tr><tr><td>Заработано</td><td>{{ (stats.earnings_kopeks / 100)|round(0, 'floor') }} ₽</td></tr></tbody></table></section>{% if stats.referrals %}<section class="panel detail"><h2>Рефералы</h2><table><thead><tr><th>Пользователь</th><th>Статус</th><th>Регистрация</th></tr></thead><tbody>{% for r in stats.referrals %}<tr><td>{{ r.email ?? ('TG ' ~ r.telegram_id) }}</td><td><span class="badge {{ r.has_made_first_topup ? 'fulfilled' : 'pending' }}">{{ r.has_made_first_topup ? 'Оплатил' : 'Не оплатил' }}</span></td><td>{{ r.created_at|date('d.m.Y') }}</td></tr>{% endfor %}</tbody></table></section>{% endif %}{% if withdrawal_enabled %}<section class="panel detail"><h2>Вывод средств</h2><p class="muted">Минимальная сумма: {{ (min_withdrawal / 100)|round(0, 'floor') }} ₽. Выводятся только реферальные начисления.</p><form method="post" action="/referral/withdraw" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Сумма, ₽<input type="number" name="amount" min="{{ (min_withdrawal / 100)|round(0, 'floor') }}" required></label><label>Реквизиты<textarea name="payment_details" required maxlength="500" rows="2" placeholder="Номер карты / кошелька"></textarea></label><button class="button">Подать заявку →</button></form>{% if withdrawals %}<h2>Мои заявки</h2><table><thead><tr><th>Сумма</th><th>Статус</th><th>Дата</th></tr></thead><tbody>{% for w in withdrawals %}<tr><td>{{ (w.amount_kopeks / 100)|round(0, 'floor') }} ₽</td><td><span class="badge {{ w.status == 'paid' ? 'fulfilled' : (w.status == 'pending' ? 'pending' : 'canceled') }}">{{ w.status }}</span></td><td>{{ w.created_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% endif %}</section>{% endif %}{% endblock %}
