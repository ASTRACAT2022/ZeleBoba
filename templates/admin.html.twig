{% extends 'base.html.twig' %}{% block title %}Управление{% endblock %}{% block content %}<header><div><p class="eyebrow">ОПЕРАЦИОННЫЙ КОНТРОЛЬ</p><h1>Управление биллингом.</h1><p class="muted">Очередь, тарифы и последние операции.</p></div><div class="inline-layout-3"><form method="post" action="/admin/maintenance"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="enabled" value="{{ maintenance ? '0' : '1' }}"><button class="button light">{{ maintenance ? 'Снять техработы' : 'Включить техработы' }}</button></form><form method="post" action="/admin/sync"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button">Синхронизировать с Remnawave →</button></form></div></header>{% include '_admin-nav.html.twig' %}<section class="panel"><div class="section-heading"><h2>Очередь обработки</h2><span>{{ jobs|length }} в выборке</span></div><div class="table-wrap"><table><thead><tr><th>Операция</th><th>Статус</th><th>Попытки</th><th>Действие</th></tr></thead><tbody>{% for j in jobs %}<tr><td>{{ j.topic }}<small>{{ j.id|slice(0,8) }}</small></td><td>{{ j.status }}<small>{{ j.last_error }}</small></td><td>{{ j.attempts }}</td><td>{% if j.status == 'dead' %}<form method="post" action="/admin/jobs/{{ j.id }}/retry"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button small">Повторить</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="4">Нет ожидающих или ошибочных заданий.</td></tr>{% endfor %}</tbody></table></div></section><section class="panel detail"><h2 id="new-plan">Добавить тариф</h2><form method="post" action="/admin/plans" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Название<input name="name" required maxlength="100"></label><label>Стоимость, копейки<input type="number" name="price_minor" min="100" max="100000000" required></label><label>Длительность, дни<input type="number" name="duration_days" min="1" max="3650" value="30" required></label><label>Устройства<input type="number" name="devices" min="1" max="20" value="3" required></label><label>Трафик, ГБ (0 = безлимит)<input type="number" name="traffic_gb" min="0" max="100000" value="0" required></label><button class="button">Создать тариф</button></form></section><section class="panel"><div class="section-heading"><h2>Последние заказы</h2></div>{% include '_orders.html.twig' with {orders:recent} %}</section><section class="panel detail"><h2>Журнал действий</h2>{% for a in audit %}<p class="audit">{{ a.created_at|date('d.m H:i') }} · {{ a.action }} · {{ a.subject|slice(0,8) }}</p>{% else %}<p>Событий пока нет.</p>{% endfor %}</section>{% endblock %}
