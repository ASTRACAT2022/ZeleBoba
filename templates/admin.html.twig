{% extends 'base.html.twig' %}{% block title %}ASTRACAT Control{% endblock %}{% block content %}<header class="control-header"><div><p class="eyebrow">ASTRACAT CONTROL · PRODUCTION</p><h1>Состояние системы <span class="system-healthy">● Всё работает</span></h1><p class="muted">{{ now|date('d.m.Y · H:i') }} · Нажмите <kbd>⌘ K</kbd> для быстрого поиска или перехода.</p></div><div class="inline-layout-3"><a class="button secondary" href="/admin/operations">Открыть операции</a><a class="button light" href="/admin/broadcasts">Рассылки</a><a class="button light" href="/admin/intelligence">Контроль системы</a></div></header>{% include '_admin-nav.html.twig' %}<section class="control-metrics"><article><small>Выручка сегодня</small><strong>{{ metrics.revenue|rub }}</strong><span>Успешно зачислено</span></article><article><small>Успешные платежи</small><strong>{{ metrics.payments }}</strong><span>С начала дня</span></article><article><small>Активные подписки</small><strong>{{ metrics.active }}</strong><span>С действующим сроком</span></article><article class="{{ metrics.attention ? 'metric-attention' : '' }}"><small>Требуют внимания</small><strong>{{ metrics.attention }}</strong><span>{{ metrics.attention ? 'Нужно проверить' : 'Нарушений нет' }}</span></article></section><section class="control-layout"><section class="panel detail"><div class="section-heading"><h2>Состояние платформы</h2><a href="/admin/intelligence">Подробный контроль →</a></div><div class="health-list">{% for service in platform %}<article><span class="health-dot {{ service.state }}">{{ service.state == 'healthy' ? '●' : (service.state == 'failed' ? '✕' : '⚠') }}</span><div><strong>{{ service.name }}</strong><small>{{ service.note }}</small></div><span class="health-label {{ service.state }}">{{ service.state == 'healthy' ? 'Работает' : (service.state == 'failed' ? 'Ошибка' : 'Требует внимания') }}</span></article>{% endfor %}</div></section><section class="panel detail"><div class="section-heading"><h2>Требуют внимания</h2><a href="/admin/provisioning">Открыть очередь →</a></div><div class="attention-list">{% if metrics.attention %}<p>⚠ {{ metrics.attention }} операций ожидают проверки или повторной синхронизации.</p>{% else %}<p class="positive">● Очередь и выдача VPN без проблем.</p>{% endif %}{% if maintenance %}<p class="notice">Техработы включены: новые покупки могут быть ограничены.</p>{% endif %}<a class="button secondary small" href="/admin/intelligence">Инварианты и кейсы</a></div></section></section><section class="panel"><div class="section-heading"><div><h2>Очередь обработки</h2><span>{{ jobs|length }} операций в выборке</span></div><a href="/admin/operations">Все операции →</a></div><div class="table-wrap"><table><thead><tr><th>Операция</th><th>Статус</th><th>Попытки</th><th>Действие</th></tr></thead><tbody>{% for j in jobs %}<tr><td>{{ j.topic }}<small>{{ j.id|slice(0,8) }}</small>{% if j.subscription_id is defined %}<a href="/admin/subscriptions/{{ j.subscription_id }}">Открыть подписку</a>{% endif %}</td><td><span class="badge {{ j.status == 'dead' ? 'canceled' : (j.status == 'pending' ? 'pending' : 'fulfilled') }}">{{ j.status }}</span><small>{{ j.last_error }}</small></td><td>{{ j.attempts }}</td><td>{% if j.status == 'dead' %}<form method="post" action="/admin/jobs/{{ j.id }}/retry"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button small">Повторить</button></form>{% else %}—{% endif %}</td></tr>{% else %}<tr><td colspan="4">Нет ожидающих или ошибочных заданий.</td></tr>{% endfor %}</tbody></table></div></section><section class="panel"><div class="section-heading"><h2>Последние заказы</h2><a href="/admin/operations">Исследовать операции →</a></div>{% include '_orders.html.twig' with {orders:recent} %}</section>{% endblock %}
