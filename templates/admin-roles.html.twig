{% extends 'base.html.twig' %}{% block title %}Роли и права{% endblock %}{% block content %}<header><div><p class="eyebrow">RBAC</p><h1>Роли и права.</h1><p class="muted">Гранулярный доступ к админке.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Создать роль</h2><form method="post" action="/admin/roles" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Название<input name="name" required maxlength="100"></label><label>Описание<input name="description" maxlength="500"></label><label>Уровень<input type="number" name="level" min="0" value="0"></label><label>Права<select name="permissions[]" multiple size="8">{% for p in permissions %}<option value="{{ p }}">{{ p }}</option>{% endfor %}</select></label><button class="button">Создать →</button></form></section><section class="panel detail"><h2>Назначить роль</h2><form method="post" action="/admin/roles/assign" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Пользователь<select name="user_id">{% for u in users %}<option value="{{ u.id }}">{{ u.email ?? ('TG ' ~ u.telegram_id) }}</option>{% endfor %}</select></label><label>Роль<select name="role_id">{% for r in roles %}<option value="{{ r.id }}">{{ r.name }}</option>{% endfor %}</select></label><button class="button">Назначить →</button></form></section><section class="panel detail"><h2>Роли</h2>{% if roles %}<table><thead><tr><th>Название</th><th>Уровень</th><th>Права</th><th>Статус</th></tr></thead><tbody>{% for r in roles %}<tr><td><strong>{{ r.name }}</strong></td><td>{{ r.level }}</td><td><small>{{ r.permissions }}</small></td><td><span class="badge {{ r.is_active ? 'fulfilled' : 'canceled' }}">{{ r.is_active ? 'Активна' : 'Выключена' }}</span></td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Ролей пока нет.</p>{% endif %}</section>{% endblock %}
