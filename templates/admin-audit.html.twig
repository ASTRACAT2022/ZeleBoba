{% extends 'base.html.twig' %}{% block title %}Аудит{% endblock %}{% block content %}<header><div><p class="eyebrow">БЕЗОПАСНОСТЬ</p><h1>Аудит.</h1><p class="muted">Неизменяемый журнал действий администраторов.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail">{% if audit %}<table><thead><tr><th>Пользователь</th><th>Действие</th><th>Ресурс</th><th>Статус</th><th>IP</th><th>Время</th></tr></thead><tbody>{% for a in audit %}<tr><td>{{ a.user_id|slice(0,8) }}</td><td>{{ a.action }}</td><td><small>{{ a.resource_type ?? '' }} {{ a.resource_id ?? '' }}</small></td><td><span class="badge {{ a.status == 'success' ? 'fulfilled' : 'canceled' }}">{{ a.status }}</span></td><td>{{ a.ip_address ?? '—' }}</td><td>{{ a.created_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Записей пока нет.</p>{% endif %}</section>{% endblock %}
