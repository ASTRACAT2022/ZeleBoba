{% extends 'base.html.twig' %}{% block title %}Подписка{% endblock %}{% block content %}<header><div><p class="eyebrow">УПРАВЛЕНИЕ ПОДПИСКОЙ</p><h1>{{ data.sub.plan_name ?? 'Подписка' }}</h1><p class="muted">Клиент: {{ data.sub.email ?? data.sub.telegram_id ?? data.sub.user_id|slice(0,8) }}</p></div><a class="button light" href="/admin/users/{{ data.sub.user_id }}">← Профиль клиента</a></header>{% include '_admin-nav.html.twig' %}{% if saved %}<p class="notice">Изменения сохранены и применены.</p>{% endif %}
<div class="overview"><section class="connection"><div class="section-top"><span>ПОДПИСКА</span><span class="connection-icon">↗</span></div><div class="connection-empty"><h2>{{ data.sub.plan_name ?? '—' }}</h2><p>Статус: <strong>{{ data.sub.status }}</strong> · До {{ data.sub.expires_at|date('d.m.Y H:i') }} UTC</p><p>Лимит: <strong>{{ data.sub.traffic_limit_gb == 0 ? 'Безлимит' : data.sub.traffic_limit_gb ~ ' ГБ' }}</strong> · Устройства: {{ data.sub.device_limit == 0 ? 'Безлимит' : data.sub.device_limit }}</p>{% if data.panel %}<p>Использовано (панель): <strong>{{ data.panel_traffic_used_gb|round(1) }} ГБ</strong> · Панель: {{ data.panel.status ?? '—' }}{% if data.panel.expireAt %} · до {{ data.panel.expireAt|replace({'T':' ','Z':''}) }}{% endif %}</p>{% if data.panel.userTraffic is defined %}<p>Баланс трафика: <strong>{{ ((data.panel.trafficLimitBytes - data.panel.userTraffic.usedTrafficBytes) / 1073741824)|round(1) }}</strong> ГБ</p>{% endif %}{% else %}<p class="muted">Панель Remnawave: пользователь не найден (возможно, уже удалён).</p>{% endif %}</div>{% if data.sub.subscription_url %}<div class="connection-empty"><h2>Ссылка клиента</h2><p class="token">{{ data.sub.subscription_url }}</p><a class="button light" href="{{ data.sub.subscription_url }}" target="_blank" rel="noreferrer">Открыть ↗</a></div>{% endif %}</section><section class="side-card"><div class="tile-icon">⚙</div><h2>Действия</h2><p>Изменения сразу применяются в Remnawave.</p><div class="separator"></div><form method="post" action="/admin/users/{{ data.sub.user_id }}/subscriptions/{{ data.sub.id }}/traffic" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Лимит трафика, ГБ<input type="number" name="traffic_gb" min="0" max="100000" value="{{ data.sub.traffic_limit_gb }}" required></label><button class="button small">Изменить трафик</button></form><div class="separator"></div><form method="post" action="/admin/users/{{ data.sub.user_id }}/subscriptions/{{ data.sub.id }}/devices" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Устройства · 0 = безлимит<input type="number" name="devices" min="0" max="20" value="{{ data.sub.device_limit }}" required></label><button class="button small">Изменить устройства</button></form><div class="separator"></div><form method="post" action="/admin/users/{{ data.sub.user_id }}/subscriptions/{{ data.sub.id }}/extend" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Продлить, дней<input type="number" name="days" min="1" max="3650" value="30" required></label><button class="button small">Продлить</button></form><div class="separator"></div><form method="post" action="/admin/users/{{ data.sub.user_id }}/subscriptions/{{ data.sub.id }}/reset-traffic" onsubmit="return confirm('Сбросить использованный трафик в панели?');"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button small">Сбросить использованный трафик</button></form>{% if data.sub.status == 'active' or data.sub.status == 'trial' %}<div class="separator"></div><form method="post" action="/admin/users/{{ data.sub.user_id }}/subscriptions/{{ data.sub.id }}/remove" onsubmit="return confirm('Удалить эту подписку? VPN-доступ будет удалён из Remnawave, клиент потеряет доступ.');"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button small">Удалить подписку</button></form>{% endif %}</section></div>
<section class="panel detail"><h2>Сводка</h2><table><tbody><tr><td>ID подписки</td><td><code>{{ data.sub.id }}</code></td></tr><tr><td>Клиент</td><td>{{ data.sub.email ?? data.sub.telegram_id ?? data.sub.user_id }}</td></tr><tr><td>Создана</td><td>{{ data.sub.created_at|date('d.m.Y H:i') }} UTC</td></tr><tr><td>До</td><td>{{ data.sub.expires_at|date('d.m.Y H:i') }} UTC</td></tr><tr><td>Тариф</td><td>{{ data.sub.plan_name ?? '—' }}</td></tr><tr><td>Лимит трафика</td><td>{{ data.sub.traffic_limit_gb == 0 ? 'Безлимит' : data.sub.traffic_limit_gb ~ ' ГБ' }}</td></tr><tr><td>Использовано (локально)</td><td>{{ data.sub.traffic_used_gb }} ГБ</td></tr><tr><td>Устройства</td><td>{{ data.sub.device_limit == 0 ? 'Безлимит' : data.sub.device_limit }}</td></tr><tr><td>Автопродление</td><td>{{ data.sub.auto_renew ? 'Включено' : 'Выключено' }}</td></tr>{% if data.panel %}<tr><td>Remnawave ID</td><td>{{ data.panel.id }}</td></tr><tr><td>Username в панели</td><td><code>{{ data.panel.username }}</code></td></tr><tr><td>Статус в панели</td><td>{{ data.panel.status }}</td></tr>{% endif %}</tbody></table></section>{% endblock %}
