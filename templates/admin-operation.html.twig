{% extends 'base.html.twig' %}{% block title %}Операция{% endblock %}{% block content %}<header><div><p class="eyebrow">ОПЕРАЦИЯ</p><h1>{{ operation.type }}</h1><p class="muted">{{ operation.id }} · {{ operation.correlation_id }}</p></div><a class="button light" href="/admin/operations">← Все операции</a></header>{% include '_admin-nav.html.twig' %}
<section class="panel detail"><p><strong>Статус:</strong> <span class="badge {{ operation.status == 'success' ? 'fulfilled' : (operation.status == 'failed' ? 'canceled' : 'pending') }}">{{ operation.status }}</span></p><p>Trace: <code>{{ operation.trace_id }}</code></p><p>Order: {{ operation.order_id ?? '—' }} · Payment: {{ operation.provider_payment_id ?? operation.payment_id ?? '—' }} · Subscription: {{ operation.subscription_id ?? '—' }}</p></section>
<section class="panel detail"><h2>Ход операции</h2><ol class="customer-timeline">{% for e in operation.events %}<li><time>{{ e.occurred_at|date('d.m.Y H:i:s') }}</time><span><strong>{{ e.status == 'success' ? '✅' : (e.status == 'failed' ? '❌' : '⚠') }} {{ e.message }}</strong><br><small>{{ e.type }}</small></span></li>{% endfor %}</ol></section>
<section class="panel detail"><h2>Очередь событий</h2>{% if operation.outbox %}<table><thead><tr><th>Событие</th><th>Статус</th><th>Попытки</th><th>Ошибка</th></tr></thead><tbody>{% for job in operation.outbox %}<tr><td>{{ job.topic }}</td><td>{{ job.status }}</td><td>{{ job.attempts }}</td><td>{{ job.last_error ?? '—' }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Событий в очереди нет.</p>{% endif %}</section>{% endblock %}
