{% extends 'base.html.twig' %}{% block title %}Кампании{% endblock %}{% block content %}<header><div><p class="eyebrow">МАРКЕТИНГ</p><h1>Кампании.</h1><p class="muted">Трекинг рекламных кампаний с бонусами.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Создать кампанию</h2><form method="post" action="/admin/campaigns" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Название<input name="name" required maxlength="255"></label><label>Start-параметр<input name="start_parameter" required maxlength="64" placeholder="summer2026"></label><label>Тип бонуса<select name="bonus_type"><option value="balance">Баланс</option><option value="subscription">Подписка</option></select></label><label>Бонус, копейки<input type="number" name="balance_bonus_kopeks" min="0" value="0"></label><label>Дней подписки<input type="number" name="subscription_duration_days" min="0" max="3650"></label><label>Тариф для подписки<select name="plan_id"><option value="">Выберите для бонуса днями</option>{% for plan in plans %}<option value="{{ plan.id }}">{{ plan.name }}</option>{% endfor %}</select></label><label>ID партнёра<input name="partner_user_id"></label><button class="button">Создать →</button></form><p class="muted">Ссылка: https://t.me/&lt;бот&gt;?start=&lt;параметр&gt;</p></section><section class="panel detail"><h2>Кампании</h2>{% if campaigns %}<table><thead><tr><th>Название</th><th>Параметр</th><th>Бонус</th><th>Статус</th></tr></thead><tbody>{% for c in campaigns %}<tr><td>{{ c.name }}</td><td>{{ c.start_parameter }}</td><td>{{ c.bonus_type == 'balance' ? (c.balance_bonus_kopeks / 100) ~ ' ₽' : c.subscription_duration_days ~ ' дн.' }}</td><td><span class="badge {{ c.is_active ? 'fulfilled' : 'canceled' }}">{{ c.is_active ? 'Активна' : 'Выключена' }}</span></td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Кампаний пока нет.</p>{% endif %}</section>{% endblock %}
