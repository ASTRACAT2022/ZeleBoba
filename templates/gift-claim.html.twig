{% extends 'base.html.twig' %}{% block title %}Активация подарка{% endblock %}{% block content %}<header>
  <div>
    <p class="eyebrow">Подарок</p>
    <h1>Активировать подарок</h1>
    <p class="muted">Введите код из сообщения.</p>
  </div>
</header>
<section class="panel detail" style="max-width:520px">
  <form method="post" action="/gifts/claim">
    <input type="hidden" name="_csrf" value="{{ user.csrf }}">
    <label>Код или ссылка<input name="code" value="{{ code|default('') }}" required maxlength="300" placeholder="GIFT_… или https://t.me/…"></label>
    <button class="button full">Активировать</button>
  </form>
</section>
{% endblock %}
