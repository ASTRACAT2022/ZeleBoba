{% extends 'base.html.twig' %}{% block title %}Готовность к запуску{% endblock %}{% block content %}<header><div><p class="eyebrow">ПЕРЕД ПЕРВЫМ КЛИЕНТОМ</p><h1>Проверка готовности.</h1><p class="muted">Текущее состояние сервиса. Проверки не заменяют реальную тестовую покупку и восстановление резервной копии.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel readiness-list">{% for check in checks %}<article><span class="check-icon {{ check.ok ? 'good' : 'warning' }}">{{ check.ok ? '✓' : '!' }}</span><div><h3>{{ check.label }}</h3><p>{{ check.detail }}</p></div><span class="badge {{ check.ok ? 'fulfilled' : 'pending' }}">{{ check.ok ? 'Готово' : 'Нужно настроить' }}</span></article>{% endfor %}</section>{% endblock %}
