{% extends 'base.html.twig' %}{% block title %}Подарки{% endblock %}{% block content %}<header><div><p class="eyebrow">ПОДАРКИ</p><h1>Дарите подписки.</h1><p class="muted">Купите подписку в подарок и отправьте код другу.</p></div></header>{% if gift_enabled %}<section class="panel detail"><h2>Купить подарок</h2><form method="post" action="/gifts/buy" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="idempotency_key" value="{{ key }}"><label>Тариф<select name="plan_id">{% for p in plans %}<option value="{{ p.id }}">{{ p.name }} · {{ p.price_minor|rub }}</option>{% endfor %}</select></label><label>Кому (необязательно)<input name="recipient_value" maxlength="255" placeholder="@username или email"></label><label>Сообщение (необязательно)<textarea name="gift_message" maxlength="500" rows="2"></textarea></label><button class="button">Купить подарок →</button></form><p class="muted">Оплата с баланса. После покупки вы получите код GIFT_... — отправьте его другу. Активировать собственный подарок нельзя.</p></section>{% else %}<p class="notice">Подарки временно недоступны.</p>{% endif %}<section class="panel detail"><h2>Активировать подарок</h2><form method="post" action="/gifts/claim" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Код или ссылка<input name="code" required maxlength="300" placeholder="GIFT_... или https://t.me/..."></label><button class="button">Активировать →</button></form></section>{% if bought %}<section class="panel detail"><h2>Мои подарки</h2><table><thead><tr><th>Тариф</th><th>Код</th><th>Статус</th><th>Дата</th></tr></thead><tbody>{% for g in bought %}<tr><td>{{ g.period_days }} дн.</td><td><code>{{ ('GIFT_' ~ g.token|slice(0,59)) }}</code></td><td><span class="badge {{ g.status == 'delivered' ? 'fulfilled' : 'pending' }}">{{ g.status == 'delivered' ? 'Активирован' : 'Ожидает активации' }}</span></td><td>{{ g.created_at|date('d.m.Y') }}</td></tr>{% endfor %}</tbody></table></section>{% endif %}{% if received %}<section class="panel detail"><h2>Полученные подарки</h2><table><thead><tr><th>Тариф</th><th>Дата</th></tr></thead><tbody>{% for g in received %}<tr><td>{{ g.period_days }} дн.</td><td>{{ g.delivered_at|date('d.m.Y') }}</td></tr>{% endfor %}</tbody></table></section>{% endif %}{% endblock %}
