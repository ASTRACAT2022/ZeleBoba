{% extends 'base.html.twig' %}{% block title %}Тарифы{% endblock %}{% block content %}
<header>
  <div>
    <p class="eyebrow">Подключение</p>
    <h1>Выберите период</h1>
    <p class="muted">Разовая оплата. Каждая покупка создаёт отдельную подписку в кабинете.</p>
  </div>
</header>

{% if not purchases_enabled %}<div class="alert alert-warning" role="status"><span class="alert-icon" aria-hidden="true">◆</span><span>Новые покупки временно приостановлены. Действующие подписки доступны в кабинете.</span></div>{% endif %}
{% if not plans %}<div class="empty"><span aria-hidden="true">⊞</span><h3>Нет доступных тарифов</h3><p>Загляните позже — мы обновляем тарифную сетку.</p></div>{% endif %}

{% if plans %}
<div class="pricing" data-pricing>
  {# ---------- Term selector ---------- #}
  <div>
    <fieldset style="border:0;margin:0;padding:0">
      <legend class="sr-only">Период подписки</legend>
      <ul class="term-list">
      {% for p in plans %}
        <li>
          <label class="term">
            <input type="radio" name="term" value="{{ p.id }}" {{ loop.index == 1 ? 'checked' : '' }}
              data-name="{{ p.name }}" data-price="{{ p.price_minor|rub }}"
              data-cta="Перейти к оплате">
            <span class="term-body">
              <span class="term-name">{{ p.name }}</span>
              <span class="term-meta">{{ p.duration_days }} дней · {{ p.traffic_bytes == 0 ? 'безлимитный трафик' : (((p.traffic_bytes / 1073741824)|round) ~ ' ГБ трафика') }}</span>
            </span>
            {% if loop.index == 2 %}<span class="term-badge">Популярный</span>{% endif %}
            <span class="term-price">{{ p.price_minor|rub }}</span>
          </label>
        </li>
      {% endfor %}
      </ul>
    </fieldset>
    <ul class="feature-list" style="margin-top:18px">
      <li>Устройства: без ограничений</li>
      <li>Обход ограничений и фильтраций</li>
      <li>Доступ ко всей инфраструктуре {{ site_name }}</li>
    </ul>
  </div>

  {# ---------- Order summary + term forms ---------- #}
  <aside class="panel detail summary" style="margin-top:0" aria-label="Итог заказа">
    <h2 style="margin-bottom:14px">Итог</h2>
    <div class="summary-row"><span>Тариф</span><span data-summary-plan>{{ plans|first.name }}</span></div>
    <div class="summary-total"><span>Итого</span><span class="price" data-summary-total>{{ plans|first.price_minor|rub }}</span></div>
    {% for p in plans %}
    <div data-term-panel="{{ p.id }}" {% if not loop.first %}hidden{% endif %}>
      {% if p.is_trial_available and trial_available %}
      <form method="post" action="/trial" style="margin-top:16px">
        <input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="plan_id" value="{{ p.id }}">
        <button class="button light full">{{ p.trial_price_kopeks > 0 ? ('Попробовать за ' ~ (p.trial_price_kopeks|rub)) : 'Попробовать бесплатно' }} · {{ p.trial_duration_days ?: 3 }} дн.</button>
      </form>
      {% endif %}
      <form method="post" action="/orders" style="margin-top:16px">
        <input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="plan_id" value="{{ p.id }}">
        <input type="hidden" name="idempotency_key" value="{{ key }}:{{ p.id }}">
        {% if receipt_required and not user.email %}<label>Email для чека<input type="email" name="receipt_email" required maxlength="254" placeholder="email@example.com"></label>{% endif %}
        <button class="button large full" data-summary-cta {{ not purchases_enabled ? 'disabled' : '' }}>Перейти к оплате</button>
      </form>
      {% if user.balance_kopeks >= p.price_minor %}
      <form method="post" action="/orders/balance" style="margin-top:8px">
        <input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="plan_id" value="{{ p.id }}">
        <input type="hidden" name="idempotency_key" value="balance:{{ key }}:{{ p.id }}">
        <button class="button secondary full" {{ not purchases_enabled ? 'disabled' : '' }}>Оплатить с баланса ({{ p.price_minor|rub }})</button>
      </form>
      {% endif %}
    </div>
    {% endfor %}
    <p class="hint" style="margin:14px 0 0">Стоимость фиксируется при создании заказа. Автоматических списаний нет.</p>
  </aside>
</div>
<script nonce="{{ style_nonce }}">
/* Show the summary forms for the selected term (progressive enhancement). */
(() => {
  const root = document.querySelector('[data-pricing]');
  if (!root) return;
  const panels = [...root.querySelectorAll('[data-term-panel]')];
  const sync = () => {
    const checked = root.querySelector('input[name="term"]:checked');
    panels.forEach((panel) => { panel.hidden = !checked || panel.dataset.termPanel !== checked.value; });
  };
  root.addEventListener('change', (e) => { if (e.target.name === 'term') sync(); });
  root.addEventListener('click', sync);
  sync();
})();
</script>
{% endif %}
{% endblock %}
