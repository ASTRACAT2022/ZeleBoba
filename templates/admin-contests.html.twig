{% extends 'base.html.twig' %}{% block title %}Конкурсы{% endblock %}{% block content %}<header><div><p class="eyebrow">МАРКЕТИНГ</p><h1>Конкурсы.</h1><p class="muted">Ежедневные игры с призами.</p></div></header><section class="panel detail"><h2>Создать шаблон</h2><form method="post" action="/admin/contests" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Название<input name="name" required maxlength="100"></label><label>Слаг<input name="slug" required maxlength="50" placeholder="daily-lucky"></label><label>Тип приза<select name="prize_type"><option value="days">Дни подписки</option><option value="balance">Баланс</option><option value="traffic">Трафик</option></select></label><label>Приз (дни/копейки/ГБ)<input name="prize_value" required value="1"></label><label>Макс. победителей<input type="number" name="max_winners" min="1" value="1"></label><label>Попыток в день<input type="number" name="times_per_day" min="1" value="1"></label><label>Кулдаун, ч<input type="number" name="cooldown_hours" min="1" value="24"></label><button class="button">Создать →</button></form></section><section class="panel detail"><h2>Шаблоны</h2>{% if templates %}<table><thead><tr><th>Название</th><th>Приз</th><th>Статус</th><th></th></tr></thead><tbody>{% for t in templates %}<tr><td>{{ t.name }}</td><td>{{ t.prize_value }} {{ t.prize_type }}</td><td><span class="badge {{ t.is_enabled ? 'fulfilled' : 'canceled' }}">{{ t.is_enabled ? 'Активен' : 'Выключен' }}</span></td><td><form method="post" action="/admin/contests/{{ t.id }}/round"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button light small">Запустить раунд</button></form></td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Шаблонов пока нет.</p>{% endif %}</section>{% endblock %}
