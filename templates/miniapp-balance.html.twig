{% extends '_miniapp_layout.html.twig' %}
{% block title %}Баланс{% endblock %}
{% block page_id %}orders{% endblock %}
{% block topbar_hi %}💰 Баланс{% endblock %}
{% block content %}
<section class="balance-card">
  <div class="balance-top">
    <span class="balance-label">Доступно</span>
    <span class="balance-pill">RUB</span>
  </div>
  <div class="balance-amount"><span class="num">{{ balance|rub }}</span></div>
</section>

<section class="block">
  <div class="block-head"><h2>Пополнить</h2></div>
  <form method="post" action="/balance/topup" class="topup-form" id="topup-form">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <input type="hidden" name="idempotency_key" value="{{ key }}">
    <label class="field">
      <span class="field-label">Сумма, ₽</span>
      <input type="number" name="amount" min="1" max="1000000" step="1" required inputmode="numeric" placeholder="500" class="field-input">
    </label>
    <label class="field">
      <span class="field-label">Способ оплаты</span>
      <div class="provider-grid">
        {% for id, name in providers %}
        <label class="provider-chip">
          <input type="radio" name="provider" value="{{ id }}" {% if loop.first %}checked{% endif %}>
          <span>{{ name }}</span>
        </label>
        {% endfor %}
      </div>
    </label>
    <button class="btn-primary" type="submit" data-haptic="success">Пополнить →</button>
  </form>
</section>

{% if topups %}
<section class="block">
  <div class="block-head"><h2>Пополнения</h2></div>
  <div class="order-list">
    {% for t in topups %}
    <div class="order-card">
      <div class="order-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
      </div>
      <div class="order-body">
        <div class="order-name">Пополнение</div>
        <div class="order-meta">{{ t.created_at|date('d.m.Y H:i') }}</div>
      </div>
      <div class="order-right">
        <div class="order-price num">{{ t.amount_kopeks|rub }}</div>
        <span class="order-status order-status--{{ t.status }}">{% if t.status == 'pending' %}ожидает{% elseif t.status == 'paid' %}зачислено{% else %}отменён{% endif %}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{% if history %}
<section class="block">
  <div class="block-head"><h2>История</h2></div>
  <div class="history-list">
    {% for h in history %}
    <div class="history-row">
      <div class="history-body">
        <div class="history-name">{{ h.description ?? h.type }}</div>
        <div class="history-meta">{{ h.created_at|date('d.m.Y H:i') }}</div>
      </div>
      <div class="history-amount num {{ h.amount_kopeks > 0 ? 'pos' : 'neg' }}">{{ h.amount_kopeks > 0 ? '+' : '' }}{{ h.amount_kopeks|rub }}</div>
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}
{% endblock %}
