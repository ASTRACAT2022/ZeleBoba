{% extends 'base.html.twig' %}{% block title %}Operations{% endblock %}{% block content %}<header><div><p class="eyebrow">OBSERVABILITY</p><h1>Operations.</h1><p class="muted">Полная бизнес-цепочка платежей, подписок, очередей и provisioning.</p></div></header>{% include '_admin-nav.html.twig' %}
<section class="panel detail"><form method="get" class="row-form"><label>Поиск<input name="q" value="{{ q }}" placeholder="Payment, order, subscription, user, Telegram, correlation…"></label><label>Операция<select name="type"><option value="">Все</option>{% for value,label in {'payment.apply':'Payment','subscription.renew':'Renewal','provisioning.retry':'Provisioning','reconciliation.subscription':'Reconciliation','wallet.debit':'Balance'} %}<option value="{{ value }}" {{ type == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label>Статус<select name="status"><option value="">Все</option>{% for value in ['success','processing','warning','failed'] %}<option value="{{ value }}" {{ status == value ? 'selected' : '' }}>{{ value }}</option>{% endfor %}</select></label><label>Период<select name="period">{% for value,label in {'today':'Сегодня','24h':'24 часа','7d':'7 дней','30d':'30 дней'} %}<option value="{{ value }}" {{ period == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><button class="button small">Найти</button></form></section>
<section class="panel detail"><h2>Операции</h2>{% if operations %}<table><thead><tr><th>Операция</th><th>Статус</th><th>Пользователь</th><th>Связанные объекты</th><th>Время</th></tr></thead><tbody>{% for o in operations %}<tr><td><a href="/admin/operations/{{ o.id }}">{{ o.type }}</a><br><small>{{ o.correlation_id }}</small></td><td><span class="badge {{ o.status == 'success' ? 'fulfilled' : (o.status == 'failed' ? 'canceled' : 'pending') }}">{{ o.status }}</span></td><td>{{ o.email ?? (o.telegram_id ? 'TG ' ~ o.telegram_id : o.user_id|slice(0,8)) }}</td><td><small>{{ o.payment_id ?? o.order_id ?? o.subscription_id ?? '—' }}</small></td><td>{{ o.started_at|date('d.m.Y H:i:s') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Операций по этому запросу нет.</p>{% endif %}</section>{% endblock %}
