{% extends 'base.html.twig' %}{% block title %}Creators{% endblock %}{% block content %}<header><div><p class="eyebrow">ASTRACAT CREATORS</p><h1>{{ data.creator.name }}</h1><p class="muted">Ваши начисления и результаты продвижения.</p></div><div class="price">{{ data.balance.total|rub }}</div></header><section class="grid"><article class="panel"><small>Доступно</small><h2>{{ data.balance.available|rub }}</h2></article><article class="panel"><small>Ожидает</small><h2>{{ data.balance.pending|rub }}</h2></article><article class="panel"><small>Оплаченных покупок</small><h2>{{ data.stats.payments }}</h2></article></section><section class="panel detail"><h2>Ваша реферальная ссылка</h2><code class="token">{{ app_url }}?ref={{ data.creator.code }}</code><p class="muted">Добавьте <code>&amp;campaign=tiktok_september</code>, чтобы разделять площадки.</p></section><section class="panel detail"><h2>Запросить выплату</h2><form method="post" action="/creators/payouts" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Сумма, ₽<input name="amount" type="number" min="1" required></label><label>Реквизиты<textarea name="details" minlength="5" maxlength="500" required></textarea></label><button class="button">Вывести средства</button></form></section><section class="panel detail"><h2>История начислений</h2><table><thead><tr><th>Дата</th><th>Тип</th><th>Покупка</th><th>Вознаграждение</th><th>Статус</th></tr></thead><tbody>{% for c in data.commissions %}<tr><td>{{ c.created_at|date('d.m.Y') }}</td><td>{{ c.kind == 'first' ? 'Первая покупка' : 'Покупка' }}</td><td>{{ c.amount_minor|rub }}</td><td>+{{ c.commission_minor|rub }}</td><td>{{ c.status }}</td></tr>{% else %}<tr><td colspan="5" class="muted">Начислений пока нет.</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
