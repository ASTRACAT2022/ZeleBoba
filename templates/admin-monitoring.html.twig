{% extends 'base.html.twig' %}{% block title %}Мониторинг{% endblock %}{% block content %}<header><div><p class="eyebrow">ЭКСПЛУАТАЦИЯ</p><h1>Мониторинг.</h1><p class="muted">События, ошибки и аномалии трафика.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Аномалии трафика</h2>{% if anomalies %}<table><thead><tr><th>Пользователь</th><th>Использовано</th><th>Лимит</th></tr></thead><tbody>{% for a in anomalies %}<tr><td>{{ a.email ?? ('TG ' ~ a.telegram_id) }}</td><td>{{ a.traffic_used_gb }} ГБ</td><td>{{ a.traffic_limit_gb }} ГБ</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Аномалий нет.</p>{% endif %}</section><section class="panel detail"><h2>Ошибки системы <form method="post" action="/admin/monitoring/clear" style="display:inline"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button light small">Очистить</button></form></h2>{% if errors %}<table><thead><tr><th>Тип</th><th>Сообщение</th><th>Кол-во</th><th>Последний раз</th></tr></thead><tbody>{% for e in errors %}<tr><td>{{ e.error_type }}</td><td><small>{{ e.message }}</small></td><td>{{ e.count }}</td><td>{{ e.last_seen|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Ошибок нет.</p>{% endif %}</section><section class="panel detail"><h2>Последние события</h2>{% if events %}<table><thead><tr><th>Тип</th><th>Сообщение</th><th>Статус</th><th>Время</th></tr></thead><tbody>{% for e in events %}<tr><td>{{ e.event_type }}</td><td><small>{{ e.message }}</small></td><td><span class="badge {{ e.is_success ? 'fulfilled' : 'canceled' }}">{{ e.is_success ? 'OK' : 'Ошибка' }}</span></td><td>{{ e.created_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Событий нет.</p>{% endif %}</section>{% endblock %}
