{% extends 'base.html.twig' %}{% block title %}Events{% endblock %}{% block content %}
<header><div><p class="eyebrow">OBSERVABILITY</p><h1>Events</h1><p class="muted">Browse and filter all tracked business operations.</p></div>
<a class="button light" href="/admin/operations">← Операции</a></header>
{% include '_admin-nav.html.twig' %}
<section class="panel detail">
<form method="get" class="row-form">
<label>Search<input name="q" value="{{ q }}" placeholder="ID, email, invoice, trace…"></label>
<label>Type<select name="type"><option value="">All</option><option value="payment" {{ type == 'payment' ? 'selected' : '' }}>Payment</option><option value="invoice" {{ type == 'invoice' ? 'selected' : '' }}>Invoice</option><option value="subscription" {{ type == 'subscription' ? 'selected' : '' }}>Subscription</option><option value="provisioning" {{ type == 'provisioning' ? 'selected' : '' }}>Provisioning</option><option value="webhook" {{ type == 'webhook' ? 'selected' : '' }}>Webhook</option><option value="email" {{ type == 'email' ? 'selected' : '' }}>Email</option><option value="authentication" {{ type == 'authentication' ? 'selected' : '' }}>Auth</option><option value="cron" {{ type == 'cron' ? 'selected' : '' }}>Cron</option><option value="system" {{ type == 'system' ? 'selected' : '' }}>System</option></select></label>
<label>Status<select name="status"><option value="">All</option><option value="success" {{ status == 'success' ? 'selected' : '' }}>Success</option><option value="processing" {{ status == 'processing' ? 'selected' : '' }}>Processing</option><option value="failed" {{ status == 'failed' ? 'selected' : '' }}>Failed</option><option value="pending" {{ status == 'pending' ? 'selected' : '' }}>Pending</option><option value="retrying" {{ status == 'retrying' ? 'selected' : '' }}>Retrying</option></select></label>
<label>Client<select name="client"><option value="">All</option></select></label>
<label>Period<select name="period"><option value="today" {{ period == 'today' ? 'selected' : '' }}>Today</option><option value="24h" {{ period == '24h' ? 'selected' : '' }}>24h</option><option value="7d" {{ period == '7d' ? 'selected' : '' }}>7 days</option><option value="30d" {{ period == '30d' ? 'selected' : '' }}>30 days</option></select></label>
<button class="button small">Filter</button>
</form>
</section>
<section class="panel detail">
<h2>Operations</h2>
{% if operations %}<table><thead><tr>
<th>Time</th><th>Type</th><th>Client</th><th>Operation</th><th>Status</th><th>Duration</th><th>Provider</th><th>Trace</th>
</tr></thead><tbody>
{% for o in operations %}
<tr>
<td>{{ (o.started_at|date('H:i:s')) }}</td>
<td>{{ o.type }}</td>
<td>{{ o.email ?? ('TG ' ~ o.telegram_id) }}</td>
<td><a href="/admin/operations/{{ o.id }}">{{ o.id }}</a></td>
<td><span class="badge {{ o.status == 'success' ? 'fulfilled' : (o.status == 'failed' ? 'canceled' : 'pending') }}">{{ o.status }}</span></td>
<td>{{ o.duration_ms ? o.duration_ms ~ ' ms' : '—' }}</td>
<td>{{ o.provider ?? '—' }}</td>
<td><code>{{ o.trace_id|slice(0, 8) }}…</code></td>
</tr>
{% endfor %}
</tbody></table>
{% else %}<p class="muted">No operations found.</p>{% endif %}
</section>
</section>
{% endblock %}
