{% extends 'base.html.twig' %}{% block title %}События{% endblock %}{% block content %}
<header><div><p class="eyebrow">МОНИТОРИНГ</p><h1>События</h1><p class="muted">Поиск и фильтрация событий операций.</p></div>
<a class="button light" href="/admin/operations">← Операции</a></header>
{% include '_admin-nav.html.twig' %}
<section class="panel detail">
<form method="get" class="row-form">
<label>Поиск<input name="q" value="{{ q }}" placeholder="ID, email, счёт, Trace ID…"></label>
<label>Тип<select name="type"><option value="">Все</option><option value="payment" {{ type == 'payment' ? 'selected' : '' }}>Платёж</option><option value="invoice" {{ type == 'invoice' ? 'selected' : '' }}>Счёт</option><option value="subscription" {{ type == 'subscription' ? 'selected' : '' }}>Подписка</option><option value="provisioning" {{ type == 'provisioning' ? 'selected' : '' }}>Выдача VPN</option><option value="webhook" {{ type == 'webhook' ? 'selected' : '' }}>Вебхук</option><option value="email" {{ type == 'email' ? 'selected' : '' }}>Email</option><option value="authentication" {{ type == 'authentication' ? 'selected' : '' }}>Авторизация</option><option value="cron" {{ type == 'cron' ? 'selected' : '' }}>Планировщик</option><option value="system" {{ type == 'system' ? 'selected' : '' }}>Система</option></select></label>
<label>Статус<select name="status"><option value="">Все</option><option value="success" {{ status == 'success' ? 'selected' : '' }}>Успешно</option><option value="processing" {{ status == 'processing' ? 'selected' : '' }}>В обработке</option><option value="failed" {{ status == 'failed' ? 'selected' : '' }}>Ошибка</option><option value="pending" {{ status == 'pending' ? 'selected' : '' }}>Ожидает</option><option value="retrying" {{ status == 'retrying' ? 'selected' : '' }}>Повтор</option></select></label>
<label>Клиент<select name="client"><option value="">Все</option></select></label>
<label>Период<select name="period"><option value="today" {{ period == 'today' ? 'selected' : '' }}>Сегодня</option><option value="24h" {{ period == '24h' ? 'selected' : '' }}>24 часа</option><option value="7d" {{ period == '7d' ? 'selected' : '' }}>7 дней</option><option value="30d" {{ period == '30d' ? 'selected' : '' }}>30 дней</option></select></label>
<button class="button small">Показать</button>
</form>
</section>
<section class="panel detail">
<h2>Операции</h2>
{% if operations %}<table><thead><tr>
<th>Время</th><th>Тип</th><th>Клиент</th><th>Операция</th><th>Статус</th><th>Длительность</th><th>Провайдер</th><th>Trace ID</th>
</tr></thead><tbody>
{% for o in operations %}
<tr>
<td>{{ (o.started_at|date('H:i:s')) }}</td>
<td>{{ o.type }}</td>
<td>{{ o.email ?? ('TG ' ~ o.telegram_id) }}</td>
<td><a href="/admin/operations/{{ o.id }}">{{ o.id }}</a></td>
<td><span class="badge {{ o.status == 'success' ? 'fulfilled' : (o.status == 'failed' ? 'canceled' : 'pending') }}">{{ o.status }}</span></td>
<td>{{ o.duration_ms ? o.duration_ms ~ ' ms' : '—' }}</td>
<td>{{ o.provider ?? '—' }}</td>
<td><code>{{ o.trace_id|slice(0, 8) }}…</code></td>
</tr>
{% endfor %}
</tbody></table>
{% else %}<p class="muted">Операции не найдены.</p>{% endif %}
</section>
{% endblock %}
