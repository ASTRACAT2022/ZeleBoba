{% extends 'base.html.twig' %}{% block title %}Очередь подтверждений{% endblock %}{% block content %}<header><div><p class="eyebrow">УПРАВЛЕНИЕ СИСТЕМОЙ</p><h1>Двухфакторная зона: подтверждение действий.</h1><p class="muted">Критичные и необратимые операции ждут подтверждения второго оператора. Нельзя подтверждать своё же действие.</p></div><a class="button light" href="/">← В кабинет</a></header>{% include '_admin-nav.html.twig' %}

<section class="panel detail">
<h2>Ожидают подтверждения</h2>
<table><thead><tr><th>Действие</th><th>Автор</th><th>Детали</th><th></th></tr></thead><tbody>
{% for r in data.pending %}
<tr><td><strong>{{ r.action }}</strong><br><small>{{ r.requested_at|date('d.m H:i') }}</small></td><td>{{ r.actor }}</td><td><code>{{ r.payload }}</code></td>
<td style="white-space:nowrap"><form method="post" action="/admin/approvals/{{ r.id }}" style="display:inline"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="decision" value="approve"><button class="button small">Подтвердить</button></form>
<form method="post" action="/admin/approvals/{{ r.id }}" style="display:inline"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="decision" value="reject"><button class="button small danger">Отклонить</button></form></td></tr>
{% else %}<tr><td colspan="4">Очередь пуста.</td></tr>{% endfor %}
</tbody></table></section>

<section class="panel detail">
<h2>История</h2>
<table><thead><tr><th>Действие</th><th>Автор</th><th>Статус</th><th>Решил</th></tr></thead><tbody>
{% for r in data.history %}
<tr><td>{{ r.action }}</td><td>{{ r.actor }}</td><td><span class="badge {{ r.status }}">{{ r.status }}</span></td><td>{{ r.decided_by ? r.decided_by ~ ' · ' ~ r.decided_at|date('d.m H:i') : '—' }}</td></tr>
{% else %}<tr><td colspan="4">Истории нет.</td></tr>{% endfor %}
</tbody></table></section>
{% endblock %}
