{% extends 'base.html.twig' %}{% block title %}Лендинги{% endblock %}{% block content %}<header><div><p class="eyebrow">МАРКЕТИНГ</p><h1>Лендинги.</h1><p class="muted">Кастомные страницы для привлечения клиентов.</p></div></header><section class="panel detail"><h2>Создать / изменить лендинг</h2><form method="post" action="/admin/landings" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Слаг<input name="slug" required maxlength="100" placeholder="summer-sale"></label><label>Заголовок<input name="title" required maxlength="200"></label><label>Подзаголовок<input name="subtitle" maxlength="500"></label><label>Скидка, %<input type="number" name="discount_percent" min="1" max="99"></label><label>Скидка с (unix)<input type="number" name="discount_starts_at"></label><label>Скидка до (unix)<input type="number" name="discount_ends_at"></label><label>Активен<select name="is_active"><option value="1">Да</option><option value="0">Нет</option></select></label><button class="button">Сохранить →</button></form><p class="muted">Лендинг доступен по адресу /l/&lt;слаг&gt;. Скидка применяется к цене тарифов.</p></section><section class="panel detail"><h2>Лендинги</h2>{% if landings %}<table><thead><tr><th>Слаг</th><th>Заголовок</th><th>Скидка</th><th>Статус</th><th></th></tr></thead><tbody>{% for l in landings %}<tr><td><a href="/l/{{ l.slug }}">/l/{{ l.slug }}</a></td><td>{{ l.title }}</td><td>{{ l.discount_percent ? l.discount_percent ~ '%' : '—' }}</td><td><span class="badge {{ l.is_active ? 'fulfilled' : 'canceled' }}">{{ l.is_active ? 'Активен' : 'Выключен' }}</span></td><td><form method="post" action="/admin/landings/{{ l.slug }}/toggle"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="active" value="{{ l.is_active ? '0' : '1' }}"><button class="button light small">{{ l.is_active ? 'Выключить' : 'Включить' }}</button></form></td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Лендингов пока нет.</p>{% endif %}</section>{% endblock %}
