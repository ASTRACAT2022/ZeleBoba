{% extends 'base.html.twig' %}{% block title %}Creators reconciliation{% endblock %}{% block content %}{% include '_admin-nav.html.twig' %}<header><div><p class="eyebrow">CREATORS · RECONCILIATION</p><h1>Сверка начислений</h1><p class="muted">Успешные платежи без комиссии будут безопасно восстановлены.</p></div></header><section class="panel detail"><form method="post"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button">Run reconciliation</button></form>{% if last %}<p>Последняя сверка: {{ last.started_at|date('d.m.Y H:i') }} · пропущено: {{ last.missing_count }} · расхождений: {{ last.inconsistent_count }}</p>{% endif %}</section><section class="panel detail"><h2>Missing commissions</h2><table><thead><tr><th>Payment</th><th>Сумма</th><th>Дата</th></tr></thead><tbody>{% for p in missing %}<tr><td>{{ p.id }}</td><td>{{ p.amount_minor|rub }}</td><td>{{ p.paid_at|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="3">Нет пропущенных начислений.</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
