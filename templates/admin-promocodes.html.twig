{% extends 'base.html.twig' %}{% block title %}Промокоды{% endblock %}{% block content %}<header><div><p class="eyebrow">МАРКЕТИНГ</p><h1>Промокоды.</h1><p class="muted">Деньги, дни подписки, триалы и скидки.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Создать промокод</h2><form method="post" action="/admin/promocodes" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Код<input name="code" required maxlength="50" placeholder="SUMMER2026"></label><label>Тип<select name="type"><option value="balance">Деньги на баланс</option><option value="subscription_days">Дни подписки</option><option value="trial_subscription">Триал</option><option value="discount">Скидка %</option><option value="balance_and_days">Деньги + дни</option></select></label><label>Бонус (копейки или %)<input type="number" name="balance_bonus_kopeks" min="0" value="0"></label><label>Дни<input type="number" name="subscription_days" min="0" value="0"></label><label>Трафик, ГБ<input type="number" name="traffic_gb" min="0" value="0"></label><label>Лимит использований<input type="number" name="max_uses" min="1" value="1"></label><label>Действует с (unix)<input type="number" name="valid_from" value="{{ now }}"></label><label>Действует до (unix, пусто = всегда)<input type="number" name="valid_until" value=""></label><label>Тариф для триала<select name="plan_id"><option value="">—</option>{% for p in plans %}<option value="{{ p.id }}">{{ p.name }}</option>{% endfor %}</select></label><label><input type="checkbox" name="first_purchase_only" value="1" style="width:auto;display:inline"> Только первая покупка</label><button class="button">Создать →</button></form></section><section class="panel detail"><h2>Промокоды</h2>{% if promocodes %}<table><thead><tr><th>Код</th><th>Тип</th><th>Бонус</th><th>Использовано</th><th>Статус</th><th></th></tr></thead><tbody>{% for p in promocodes %}<tr><td><strong>{{ p.code }}</strong></td><td>{{ p.type }}</td><td>{{ p.balance_bonus_kopeks > 0 ? (p.type == 'discount' ? p.balance_bonus_kopeks ~ '%' : (p.balance_bonus_kopeks / 100) ~ ' ₽') : (p.subscription_days > 0 ? p.subscription_days ~ ' дн.' : '—') }}</td><td>{{ p.current_uses }}/{{ p.max_uses }}</td><td><span class="badge {{ p.is_active ? 'fulfilled' : 'canceled' }}">{{ p.is_active ? 'Активен' : 'Выключен' }}</span></td><td><form method="post" action="/admin/promocodes/{{ p.id }}/toggle"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="active" value="{{ p.is_active ? '0' : '1' }}"><button class="button light small">{{ p.is_active ? 'Выключить' : 'Включить' }}</button></form></td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Промокодов пока нет.</p>{% endif %}</section>{% endblock %}
