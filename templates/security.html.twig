{% extends 'base.html.twig' %}{% block title %}Защита аккаунта{% endblock %}{% block content %}
<header>
  <div>
    <p class="eyebrow">Безопасность</p>
    <h1>Двухфакторная защита</h1>
    <p class="muted">Обязательна для управления сервисом.</p>
  </div>
</header>

<section class="panel detail security-card">
{% if recovery_codes %}
  <h2>Сохраните резервные коды</h2>
  <p class="muted">Каждый код работает один раз вместо кода приложения. Показываем их только сейчас.</p>
  <div class="recovery-grid">{% for code in recovery_codes %}<code>{{ code }}</code>{% endfor %}</div>
  <a class="button" href="{{ user.role == 'admin' ? '/admin' : '/settings' }}">Коды сохранены</a>

{% elseif secret %}
  <h2>Добавьте аккаунт в приложение</h2>
  <p class="muted">В приложении-аутентификаторе выберите ручной ввод: ключ ниже, тип — по времени, 6 цифр, SHA-1, 30 секунд.</p>
  <code class="token">{{ secret }}</code>
  <form method="post" action="/security/enroll">
    <input type="hidden" name="_csrf" value="{{ user.csrf }}">
    <label>Код из приложения<input name="code" autocomplete="one-time-code" inputmode="numeric" pattern="[0-9]{6}" required></label>
    <button class="button">Включить защиту</button>
  </form>

{% elseif user.mfa_enabled %}
  <h2>Подтвердите доступ</h2>
  <p class="muted">Административный доступ действует 15 минут после подтверждения.</p>
  <form method="post" action="/security/verify">
    <input type="hidden" name="_csrf" value="{{ user.csrf }}">
    <label>Код приложения или резервный код<input name="code" autocomplete="one-time-code" required maxlength="16"></label>
    <button class="button">Подтвердить</button>
  </form>

{% else %}
  <h2>Включите двухфакторную защиту</h2>
  <p class="muted">Подойдёт приложение, которое поддерживает одноразовые коды TOTP.</p>
  <form method="post" action="/security/begin">
    <input type="hidden" name="_csrf" value="{{ user.csrf }}">
    <button class="button">Настроить защиту</button>
  </form>
{% endif %}
</section>
{% endblock %}
