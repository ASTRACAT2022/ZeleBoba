{% extends 'base.html.twig' %}{% block title %}Рассылки{% endblock %}{% block content %}<header><div><p class="eyebrow">МАРКЕТИНГ</p><h1>Рассылки.</h1><p class="muted">Отправка сообщений по сегментам пользователей.</p></div></header><section class="panel detail"><h2>Новая рассылка</h2><form method="post" action="/admin/broadcasts" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Сегмент<select name="target_type"><option value="all">Все пользователи</option><option value="active">С активной подпиской</option><option value="inactive">Без активной подписки</option><option value="paid">Оплачивавшие</option><option value="trial">На триале</option></select></label><label>Категория<select name="category"><option value="system">Системные</option><option value="news">Новости</option><option value="promo">Промо</option></select></label><label>Текст<textarea name="message_text" required maxlength="4000" rows="4"></textarea></label><button class="button">Запустить →</button></form></section><section class="panel detail"><h2>История</h2>{% if broadcasts %}<table><thead><tr><th>Сегмент</th><th>Статус</th><th>Отправлено</th><th>Ошибки</th><th>Дата</th></tr></thead><tbody>{% for b in broadcasts %}<tr><td>{{ b.target_type }}</td><td><span class="badge {{ b.status == 'completed' ? 'fulfilled' : 'pending' }}">{{ b.status }}</span></td><td>{{ b.sent_count }}/{{ b.total_count }}</td><td>{{ b.failed_count }}</td><td>{{ b.created_at|date('d.m.Y H:i') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Рассылок пока нет.</p>{% endif %}</section>{% endblock %}
