{% extends 'base.html.twig' %}{% block title %}Обзор{% endblock %}{% block content %}<header><div><p class="eyebrow">ВАШЕ ПРОСТРАНСТВО</p><h1>Всё под контролем.</h1><p class="muted">Управляйте подключением в удобном для вас месте.</p></div><a class="button" href="/plans">+ Новая подписка</a></header><div class="overview"><section class="connection"><div class="section-top"><span>МОИ ПОДПИСКИ</span><span class="connection-icon">↗</span></div>{% if subscriptions %}{% for s in subscriptions %}<article class="subscription"><span class="badge {{ s.status == 'active' and s.expires_at > now ? 'fulfilled' : 'pending' }}">{{ s.expires_at <= now ? 'Истекла' : (s.status == 'active' ? 'Активна' : 'Готовим доступ') }}</span><h2>{{ s.plan_name }}</h2><p>До {{ s.expires_at|date('d.m.Y H:i') }} UTC · {{ s.devices == 0 ? 'Безлимит устройств' : (s.devices ~ ' устройств') }}</p>{% if s.subscription_url and s.expires_at > now %}<a class="button light" href="{{ s.subscription_url }}" rel="noreferrer">Открыть подписку ↗</a>{% elseif s.status == 'active' and demo %}<p class="notice">Тестовая подписка. Доступ к VPN не выдаётся.</p>{% else %}<p>Статус обновится после обработки заказа.</p>{% endif %}{% if s.status == 'active' and s.expires_at > now %}{% if s.is_trial %}<form method="post" action="/trial/{{ s.id }}/convert"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="plan_id" value="{{ s.plan_id }}"><button class="button light small">Перейти на платный тариф</button></form>{% endif %}<form method="post" action="/subscriptions/{{ s.id }}/renew"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="key" value="{{ s.id }}:{{ now }}"><button class="button light">Продлить подписку</button></form>{% if autorenew_enabled %}<form method="post" action="/subscriptions/{{ s.id }}/autorenew"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="enable" value="{{ s.auto_renew ? '0' : '1' }}"><button class="button light small {{ s.auto_renew ? 'danger' : '' }}">{{ s.auto_renew ? 'Отказаться от подписки (stop)' : 'Включить автооплату' }}</button></form>{% if s.auto_renew %}<p class="muted">Автооплата включена — списывается с баланса каждые сутки. Пока есть баланс, подписка работает сама.</p>{% endif %}{% else %}<p class="muted">Автооплата отключена администратором.</p>{% endif %}{% endif %}</article>{% endfor %}{% else %}<div class="connection-empty"><div class="orb">↗</div><h2>Ваш следующий шаг —<br>свободное подключение.</h2><p>Выберите подходящий тариф.<br>После оплаты подписка появится здесь.</p><a class="button light" href="/plans">Выбрать тариф <span>→</span></a></div>{% endif %}</section><section class="side-card"><span class="tile-icon">↗</span><h2>Кабинет.<br>Или Telegram.</h2><p>Одна учётная запись для подписок и покупок в двух каналах.</p><div class="separator"></div><span class="badge {{ user.telegram_id ? 'fulfilled' : '' }}">{{ user.telegram_id ? 'Telegram подключён' : 'Telegram не подключён' }}</span><a href="/settings">Настроить подключение →</a></section></div><section class="panel"><div class="section-heading"><h2>Последние платежи</h2><a href="/orders">Все заказы ↗</a></div>{% include '_orders.html.twig' %}</section>{% endblock %}
