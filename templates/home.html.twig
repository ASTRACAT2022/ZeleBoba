{% extends 'base.html.twig' %}{% block title %}Обзор{% endblock %}{% block content %}
{% set active = subscriptions|filter(s => s.status in ['active', 'trial'] and s.expires_at > now) %}
{% set primary = active|first %}

<header>
  <div>
    <p class="eyebrow">Личный кабинет</p>
    <h1>{{ site_name }} VPN</h1>
    <p class="muted">Состояние подписки, оплата и доступ — в одном месте.</p>
  </div>
</header>

{% if primary %}
{# ---------- Primary subscription state ---------- #}
<section class="panel detail primary-subscription" aria-labelledby="sub-state">
  <div class="section-heading subscription-primary-heading" >
    <h2 id="sub-state">{{ primary.plan_name|default('Основная подписка') }}</h2>
    <span class="badge active">{{ primary.status == 'trial' ? 'Пробный период' : 'Активна' }}</span>{% if primary.plan_archived %}<span class="badge plain">Архив · тариф больше не продаётся</span>{% endif %}
  </div>
  <div class="meta-grid">
    <div class="meta-item"><span class="meta-label">Статус</span><span class="meta-value">● Работает</span></div>
    <div class="meta-item"><span class="meta-label">Действует до</span><span class="meta-value">{{ primary.expires_at|date('d.m.Y') }}</span></div>
    <div class="meta-item"><span class="meta-label">Трафик</span><span class="meta-value">{% if primary.traffic_limit_gb > 0 %}{{ (primary.traffic_used_gb|default(0))|round }} / {{ primary.traffic_limit_gb|round }} ГБ{% else %}{{ (primary.traffic_used_gb|default(0))|round }} ГБ использовано · безлимит{% endif %}</span></div>
    <div class="meta-item"><span class="meta-label">Устройства</span><span class="meta-value">{{ primary.devices == 0 ? 'Без ограничений' : ('до ' ~ primary.devices) }}</span></div>
  </div>
  <div class="inline-layout-3">
    {% if primary.subscription_url %}<button class="button" type="button" data-copy="{{ primary.subscription_url }}" data-copy-label="Ссылка скопирована">Скопировать ссылку</button>{% endif %}
    {% if primary.status == 'active' and not primary.plan_archived %}<form method="post" action="/subscriptions/{{ primary.id }}/renew"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="key" value="{{ primary.id }}:{{ now }}"><button class="button secondary">Продлить подписку</button></form>{% endif %}
    <a class="button ghost" href="/plans">Сменить тариф</a>
  </div>
  {% if primary.subscription_url %}<p class="hint mt-12">Скопируйте ссылку, откройте Happ или Incy, нажмите «+» и вставьте её из буфера.</p>{% endif %}
</section>

{# ---------- Secondary subscriptions ---------- #}
{% if active|length > 1 %}
<section class="panel other-subscriptions">
  <div class="panel-head"><h2>Другие активные подписки</h2><span class="muted">{{ active|length - 1 }}</span></div>
  <div class="subscription-list">
  {% for s in active %}{% if s.id != primary.id %}
    <article class="subscription-list-item">
      <div class="subscription-list-item__heading">
        <div class="subscription-list-item__info"><strong>{{ s.plan_name|default('Подписка') }}</strong><small class="muted">{% if s.plan_archived %}<span class="badge plain">Архив · тариф больше не продаётся</span><br>{% endif %}до {{ s.expires_at|date('d.m.Y') }} · {% if s.traffic_limit_gb > 0 %}{{ (s.traffic_used_gb|default(0))|round }} / {{ s.traffic_limit_gb|round }} ГБ{% else %}безлимит{% endif %}</small></div>
        <span class="badge active">{{ s.status == 'trial' ? 'Пробный период' : 'Активна' }}</span>
      </div>
      <div class="subscription-list-item__actions">
        {% if s.subscription_url %}<button class="button small secondary" type="button" data-copy="{{ s.subscription_url }}" data-copy-label="Ссылка скопирована">Скопировать ссылку</button>{% endif %}
        {% if s.status == 'active' and not s.plan_archived %}<form method="post" action="/subscriptions/{{ s.id }}/renew"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="key" value="{{ s.id }}:{{ now }}"><button class="button small secondary">Продлить</button></form>{% endif %}
      </div>
    </article>
  {% endif %}{% endfor %}
  </div>
</section>
{% endif %}

{# ---------- Merge (existing feature, unchanged logic) ---------- #}
{% if active|length > 1 %}
<section class="merge-panel panel mt-24" >
  <div class="section-heading simple-head" ><h2>Объединить подписки</h2><span class="muted">перенос трафика и дней</span></div>
  <p class="muted">Перенесите остаток дней на другую подписку. Исходная будет удалена — <a href="/plans">подробнее</a>.</p>
  <form method="post" action="/subscriptions/merge" class="row-form">
    <input type="hidden" name="_csrf" value="{{ user.csrf }}">
    <label>Перенести из<select name="source_id" required>{% for s in active %}<option value="{{ s.id }}">{{ s.plan_name }} · до {{ s.expires_at|date('d.m.Y') }}</option>{% endfor %}</select></label>
    <label>В подписку<select name="target_id" required>{% for s in active %}<option value="{{ s.id }}">{{ s.plan_name }} · до {{ s.expires_at|date('d.m.Y') }}</option>{% endfor %}</select></label>
    <button class="button secondary">Объединить</button>
  </form>
</section>
{% endif %}

{# ---------- Quick actions ---------- #}
<div class="overview mt-24" >
  <section class="panel detail mt-0" >
    <div class="section-heading simple-head" ><h2>Быстрые действия</h2></div>
    <ul class="feature-list m-0" >
      <li><a href="/plans">Продлить или купить подписку</a></li>
      <li><a href="/balance">Пополнить баланс</a></li>
      {% if autorenew_enabled %}<li>Автопродление: {% if primary and primary.auto_renew %}<span class="badge active">включено</span>{% else %}<span class="badge">выключено</span>{% endif %}</li>{% endif %}
      <li><a href="/settings">Привязать Telegram для входов</a></li>
    </ul>
  </section>
  <section class="side-card">
    <span class="tile-icon" aria-hidden="true">↗</span>
    <h2>Кабинет и Telegram</h2>
    <p>Одна учётная запись для подписок и покупок в двух каналах.</p>
    <div class="separator"></div>
    <span class="badge {{ user.telegram_id ? 'active' : 'plain' }}">{{ user.telegram_id ? 'Telegram подключён' : 'Telegram не подключён' }}</span>
    <a href="/settings">Настроить подключение →</a>
  </section>
</div>

{% else %}
{# ---------- Empty state: no subscription ---------- #}
<section class="panel detail center" >
  <div class="empty pad-page" >
    <span aria-hidden="true">◫</span>
    <h3>Подписки пока нет</h3>
    <p>Выберите тариф — после оплаты доступ появится здесь автоматически.</p>
    <a class="button large" href="/plans">Выбрать тариф</a>
  </div>
</section>
<div class="overview mt-24" >
  <section class="panel detail mt-0" >
    <div class="section-heading simple-head" ><h2>Что вы получите</h2></div>
    <ul class="feature-list m-0" >
      <li>Стабильный VPN-доступ на всей инфраструктуре {{ site_name }}</li>
      <li>Устройства: без ограничений</li>
      <li>Обход ограничений и фильтраций</li>
      <li>Управление через веб-кабинет и Telegram</li>
    </ul>
  </section>
  <section class="side-card">
    <span class="tile-icon" aria-hidden="true">↗</span>
    <h2>Кабинет и Telegram</h2>
    <p>Одна учётная запись для подписок и покупок в двух каналах.</p>
    <div class="separator"></div>
    <a href="/settings">Настроить подключение →</a>
  </section>
</div>
{% endif %}

<section class="panel">
  <div class="section-heading"><h2>Последние платежи</h2><a href="/orders">Все платежи →</a></div>
  {% include '_orders.html.twig' %}
</section>
{% endblock %}
