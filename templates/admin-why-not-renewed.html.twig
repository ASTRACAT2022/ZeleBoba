{% extends 'base.html.twig' %}{% block title %}Почему не продлилась?{% endblock %}{% block content %}<header><div><p class="eyebrow">ОБЪЯСНЕНИЕ РЕШЕНИЯ</p><h1>Почему не продлилась?</h1><p class="muted">Подписка {{ subscription.id }} · срок {{ subscription.expires_at|date('d.m.Y H:i') }}</p></div><a class="button light" href="/admin/subscriptions/{{ subscription.id }}">← Подписка</a></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Результат проверки</h2><ol class="customer-timeline">{% for reason in reasons %}<li><time>{{ reason.ok ? '✓' : '✕' }}</time><span>{{ reason.text }}</span></li>{% endfor %}</ol><p class="notice">Деньги не списываются и подписка не меняется, пока проверка условий не завершится успешно.</p></section>{% endblock %}
