{% extends 'base.html.twig' %}{% block title %}Опросы{% endblock %}{% block content %}<header><div><p class="eyebrow">МАРКЕТИНГ</p><h1>Опросы.</h1><p class="muted">Опросы с наградами за участие.</p></div></header><section class="panel detail"><h2>Создать опрос</h2><form method="post" action="/admin/polls" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Заголовок<input name="title" required maxlength="255"></label><label>Описание<textarea name="description" rows="2"></textarea></label><label>Награда, копейки<input type="number" name="reward_amount_kopeks" min="0" value="0"></label><div id="questions"><label>Вопрос 1<input name="q_text[]" required maxlength="500"></label><label>Вариант 1<input name="q_options_0[]" required></label><label>Вариант 2<input name="q_options_0[]" required></label></div><button class="button">Создать →</button></form></section><section class="panel detail"><h2>Опросы</h2>{% if polls %}<table><thead><tr><th>Заголовок</th><th>Награда</th><th>Дата</th></tr></thead><tbody>{% for p in polls %}<tr><td>{{ p.title }}</td><td>{{ p.reward_enabled ? (p.reward_amount_kopeks / 100) ~ ' ₽' : '—' }}</td><td>{{ p.created_at|date('d.m.Y') }}</td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Опросов пока нет.</p>{% endif %}</section>{% endblock %}
