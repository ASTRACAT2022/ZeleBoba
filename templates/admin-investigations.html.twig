{% extends 'base.html.twig' %}{% block title %}Расследования{% endblock %}{% block content %}<header><div><p class="eyebrow">OPERATIONS</p><h1>Расследования.</h1><p class="muted">Рабочие пространства с контекстом, заметками и подтверждённым результатом.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="ops-kpi"><article><small>Требуют внимания</small><strong>{{ queues.need_attention }}</strong></article><article><small>Проблемы платежей</small><strong>{{ queues.payment_issues }}</strong></article><article><small>Выдача VPN</small><strong>{{ queues.provisioning }}</strong></article><article><small>Ручной разбор</small><strong>{{ queues.manual_review }}</strong></article></section><section class="panel detail"><h2>Открыть расследование</h2><form method="post" action="/admin/investigations" class="row-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>Объект<select name="subject_type"><option value="user">Клиент</option><option value="subscription">Подписка</option><option value="payment">Платёж</option><option value="incident">Инцидент</option></select></label><label>ID объекта<input name="subject_id" required maxlength="64"></label><label>Название<input name="title" maxlength="200" placeholder="Проверка состояния"></label><button class="button">Начать расследование</button></form></section><section class="panel detail"><h2>Сохранённые расследования</h2><table><thead><tr><th>Код</th><th>Тема</th><th>Статус</th><th>Создано</th></tr></thead><tbody>{% for c in cases %}<tr><td><a href="/admin/investigations/{{ c.id }}">{{ c.code }}</a></td><td>{{ c.title }}</td><td><span class="badge {{ c.status == 'open' ? 'pending' : 'fulfilled' }}">{{ c.status }}</span></td><td>{{ c.created_at|date('d.m.Y H:i') }}</td></tr>{% else %}<tr><td colspan="4">Расследований пока нет.</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
