{% extends 'base.html.twig' %}{% block title %}Синхронизация{% endblock %}{% block content %}<header><div><p class="eyebrow">УПРАВЛЕНИЕ</p><h1>Синхронизация Remnawave.</h1><p class="muted">Сверка подписок с панелью: сроки, трафик, устройства.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Результат</h2><div class="form-grid"><label>Проверено<strong>{{ report.checked }}</strong></label><label>Исправлено<strong>{{ report.fixed }}</strong></label><label>Пересоздано<strong>{{ report.reprovisioned }}</strong></label><label>Отключено<strong>{{ report.disabled }}</strong></label><label>Не найдено<strong>{{ report.missing }}</strong></label><label>Ошибок<strong>{{ report.errors }}</strong></label></div>{% if report.details %}<h3>Детали</h3><ul>{% for line in report.details %}<li><code>{{ line }}</code></li>{% endfor %}</ul>{% endif %}<form method="post" action="/admin/sync"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button">Запустить синхронизацию ещё раз →</button></form><p class="muted">Синхронизация также выполняется автоматически раз в час планировщиком.</p></section>{% endblock %}
