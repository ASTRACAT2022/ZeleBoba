{% extends 'base.html.twig' %}{% block title %}{{ landing.title }}{% endblock %}{% block content %}<header><div><p class="eyebrow">СПЕЦИАЛЬНОЕ ПРЕДЛОЖЕНИЕ</p><h1>{{ landing.title }}</h1>{% if landing.subtitle %}<p class="muted">{{ landing.subtitle }}</p>{% endif %}</div></header>{% if landing.discount_percent %}<p class="notice">Скидка {{ landing.discount_percent }}% действует на все тарифы{% if landing.discount_ends_at %} до {{ landing.discount_ends_at|date('d.m.Y') }}{% endif %}.</p>{% endif %}<div class="plans">{% for p in plans %}<article class="plan {{ loop.index == 2 ? 'featured' : '' }}"><div class="section-top"><span>0{{ loop.index }}</span><span>{{ p.duration_days }} ДНЕЙ</span></div><h2>{{ p.name }}</h2><div class="price">{{ prices[p.id]|rub }}</div><p class="muted">за весь период{% if prices[p.id] < p.price_minor %} · было {{ p.price_minor|rub }}{% endif %}</p><ul><li>{{ p.traffic_bytes == 0 ? 'Безлимитный трафик' : ((p.traffic_bytes / 1073741824)|round ~ ' ГБ трафика') }}</li><li>До {{ p.devices }} устройств</li></ul>{% if user %}<form method="post" action="/orders"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="plan_id" value="{{ p.id }}"><input type="hidden" name="idempotency_key" value="{{ key }}:{{ p.id }}"><button class="button full">Выбрать {{ p.name }} →</button></form>{% else %}<a class="button full" href="/login">Войти и купить →</a>{% endif %}</article>{% endfor %}</div>{% if landing.footer_text %}<p class="muted">{{ landing.footer_text }}</p>{% endif %}{% endblock %}
