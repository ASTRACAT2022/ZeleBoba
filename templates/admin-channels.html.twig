{% extends 'base.html.twig' %}{% block title %}Обязательные каналы{% endblock %}{% block content %}<header><div><p class="eyebrow">МАРКЕТИНГ</p><h1>Обязательные каналы.</h1><p class="muted">Подписка на каналы для доступа к боту.</p></div></header>{% include '_admin-nav.html.twig' %}<section class="panel detail"><h2>Добавить канал</h2><form method="post" action="/admin/channels" class="admin-form"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><label>ID канала<input name="channel_id" required placeholder="-1001234567890"></label><label>Ссылка<input name="channel_link" placeholder="https://t.me/channel"></label><label>Название<input name="title" maxlength="255"></label><button class="button">Добавить →</button></form></section><section class="panel detail"><h2>Каналы</h2>{% if channels %}<table><thead><tr><th>Канал</th><th>Ссылка</th><th>Статус</th><th></th></tr></thead><tbody>{% for c in channels %}<tr><td>{{ c.title ?? c.channel_id }}</td><td>{{ c.channel_link ?? '—' }}</td><td><span class="badge {{ c.is_active ? 'fulfilled' : 'canceled' }}">{{ c.is_active ? 'Активен' : 'Выключен' }}</span></td><td><form method="post" action="/admin/channels/{{ c.id }}/toggle" class="inline-layout-1"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><input type="hidden" name="active" value="{{ c.is_active ? '0' : '1' }}"><button class="button light small">{{ c.is_active ? 'Выключить' : 'Включить' }}</button></form> <form method="post" action="/admin/channels/{{ c.id }}/remove" class="inline-layout-1"><input type="hidden" name="_csrf" value="{{ user.csrf }}"><button class="button small">Удалить</button></form></td></tr>{% endfor %}</tbody></table>{% else %}<p class="muted">Каналов пока нет.</p>{% endif %}</section>{% endblock %}
