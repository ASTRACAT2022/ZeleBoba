{% extends 'base.html.twig' %}{% block title %}Ошибка{% endblock %}{% block content %}
<section class="panel detail error" style="max-width:560px;margin-top:40px">
  <div class="empty" style="padding:20px 0;text-align:left;align-items:flex-start">
    <span aria-hidden="true">◆</span>
    <h3>Не удалось выполнить действие</h3>
    <p>{{ message }}</p>
  </div>
  <a class="button" href="{{ user ? '/' : '/login' }}">{{ user ? 'В кабинет' : 'Ко входу' }}</a>
</section>
{% endblock %}
