{% extends '_miniapp_layout.html.twig' %}
{% block title %}Профиль{% endblock %}
{% block page_id %}settings{% endblock %}
{% block topbar_hi %}⚙️ Профиль{% endblock %}
{% block content %}
<section class="block">
  <div class="block-head"><h2>Аккаунт</h2></div>
  <div class="info-card">
    <div class="info-row">
      <span class="info-label">Email</span>
      <span class="info-value">{{ user.email ?? 'Telegram-аккаунт' }}</span>
    </div>
    {% if user.telegram_id %}
    <div class="info-row">
      <span class="info-label">Telegram</span>
      <span class="info-value info-value--ok">Подключён · ID {{ user.telegram_id }}</span>
    </div>
    {% endif %}
    <div class="info-row">
      <span class="info-label">Баланс</span>
      <span class="info-value num">{{ balance_kopeks|rub }}</span>
    </div>
  </div>
</section>

<section class="block">
  <div class="block-head"><h2>Промокод</h2></div>
  <form method="post" action="/promo" class="topup-form">
    <input type="hidden" name="_csrf" value="{{ user.csrf }}">
    <label class="field">
      <span class="field-label">Код</span>
      <input type="text" name="code" required maxlength="50" placeholder="SUMMER2026" class="field-input" inputmode="text" autocomplete="off">
    </label>
    <button class="btn-primary" type="submit" data-haptic="success">Активировать →</button>
  </form>
</section>

{% if not user.telegram_id %}
<section class="block">
  <div class="block-head"><h2>Подключить Telegram</h2></div>
  <div class="info-card">
    <p class="info-text">Получите одноразовый код и отправьте его боту — аккаунт привяжется.</p>
    {% if link_token %}
    <div class="link-code"><code>/link {{ link_token }}</code></div>
    <p class="info-meta">Код действует 10 минут</p>
    {% endif %}
    <form method="post" action="/settings/telegram">
      <input type="hidden" name="_csrf" value="{{ user.csrf }}">
      <button class="btn-primary" type="submit" data-haptic="light">{{ link_token ? 'Обновить код' : 'Получить код' }} →</button>
    </form>
  </div>
</section>
{% endif %}

<section class="block">
  <div class="block-head"><h2>Безопасность</h2></div>
  <div class="action-list">
    <a class="action-card" href="/security" data-haptic="light">
      <span class="action-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5 3.5 9 8 10 4.5-1 8-5 8-10V6l-8-4Z"/></svg></span>
      <span class="action-body">
        <span class="action-name">Двухфакторная защита</span>
        <span class="action-meta">{{ user.mfa_enabled ? 'Подключена' : 'Не подключена' }}</span>
      </span>
      <span class="action-chev">›</span>
    </a>
    <form method="post" action="/logout">
      <input type="hidden" name="_csrf" value="{{ user.csrf }}">
      <button type="submit" class="action-card action-card--danger" data-haptic="warning">
        <span class="action-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg></span>
        <span class="action-body">
          <span class="action-name">Выйти из аккаунта</span>
          <span class="action-meta">Завершить текущую сессию</span>
        </span>
        <span class="action-chev">›</span>
      </button>
    </form>
  </div>
</section>

{% if support_url %}
<section class="block">
  <a class="action-card" href="{{ support_url }}" data-haptic="light">
    <span class="action-icon"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg></span>
    <span class="action-body">
      <span class="action-name">Поддержка</span>
      <span class="action-meta">Связаться с оператором</span>
    </span>
    <span class="action-chev">›</span>
  </a>
</section>
{% endif %}
{% endblock %}
