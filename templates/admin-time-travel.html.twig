{% extends 'base.html.twig' %}{% block title %}Состояние на дату{% endblock %}{% block content %}<header><div><p class="eyebrow">ИССЛЕДОВАНИЕ ИСТОРИИ</p><h1>Состояние на {{ state.at|date('d.m.Y H:i') }}.</h1><p class="muted">{{ state.user.email ?? ('TG ' ~ state.user.telegram_id) }} · снимок построен из неизменяемых событий, платежей и проводок.</p></div><a class="button light" href="/admin/users/{{ state.user.id }}">← Карточка клиента</a></header>{% include '_admin-nav.html.twig' %}<section class="ops-kpi"><article><small>Баланс на тот момент</small><strong>{{ state.balance.amount|rub }}</strong></article><article><small>Платежей</small><strong>{{ state.payments|length }}</strong></article><article><small>Событий после момента</small><strong>{{ state.after|length }}</strong></article></section><section class="panel detail"><h2>Подписки и выдача VPN</h2><table><thead><tr><th>Тариф</th><th>Срок</th><th>Статус на момент</th><th>Remnawave</th></tr></thead><tbody>{% for s in state.subs %}<tr><td>{{ s.plan_name ?? '—' }}{% if s.version_number %} v{{ s.version_number }}{% endif %}</td><td>{{ s.expires_at|date('d.m.Y H:i') }}</td><td>{{ s.historical_status }}</td><td>{{ s.provisioning_state ?? 'нет данных' }}</td></tr>{% else %}<tr><td colspan="4">Подписок на тот момент не было.</td></tr>{% endfor %}</tbody></table></section><section class="panel detail"><h2>Почему состояние было таким</h2><ol class="customer-timeline">{% for event in state.events %}<li><time>{{ event.occurred_at|date('d.m H:i') }}</time><span>{{ event.event_type }}</span></li>{% else %}<li><span>Событий до выбранного момента нет.</span></li>{% endfor %}</ol></section><section class="panel detail"><h2>Что изменилось после</h2><ol class="customer-timeline">{% for event in state.after %}<li><time>{{ event.occurred_at|date('d.m H:i') }}</time><span>{{ event.event_type }}</span></li>{% else %}<li><span>После выбранного момента изменений нет.</span></li>{% endfor %}</ol></section>{% endblock %}
