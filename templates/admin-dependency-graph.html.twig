{% extends 'base.html.twig' %}{% block title %}Граф зависимостей{% endblock %}{% block content %}<header><div><p class="eyebrow">ГРАФ ЗАВИСИМОСТЕЙ</p><h1>Цепочка подписки.</h1><p class="muted">Красный узел означает, что требуется внимание оператора.</p></div><a class="button light" href="/admin/subscriptions/{{ graph.subscription.id }}">← Подписка</a></header>{% include '_admin-nav.html.twig' %}<section class="dependency-graph"><article class="graph-node"><small>Клиент</small><strong>{{ graph.user.label }}</strong></article><div class="graph-line"></div><article class="graph-node {{ graph.subscription.lifecycle_status == 'active' ? '' : 'graph-warn' }}"><small>Подписка</small><strong>{{ graph.subscription.lifecycle_status }}</strong><span>до {{ graph.subscription.expires_at|date('d.m.Y') }}</span></article><div class="graph-branches"><div><div class="graph-line"></div><article class="graph-node {{ graph.order and graph.order.workflow_status in ['paid','fulfilled'] ? '' : 'graph-warn' }}"><small>Заказ</small><strong>{{ graph.order ? graph.order.workflow_status : 'нет' }}</strong></article><div class="graph-line"></div><article class="graph-node {{ graph.payment and graph.payment.status == 'succeeded' ? '' : 'graph-warn' }}"><small>Платёж</small><strong>{{ graph.payment ? graph.payment.status : 'нет' }}</strong></article><div class="graph-line"></div><article class="graph-node {{ graph.ledger|length ? '' : 'graph-warn' }}"><small>Проводки</small><strong>{{ graph.ledger|length }}</strong></article></div><div><div class="graph-line"></div><article class="graph-node {{ graph.provisioning and graph.provisioning.state == 'active' ? '' : 'graph-warn' }}"><small>Выдача VPN</small><strong>{{ graph.provisioning ? graph.provisioning.state : 'нет' }}</strong><span>{{ graph.provisioning ? graph.provisioning.provider : '' }}</span></article></div></div></section>{% endblock %}
