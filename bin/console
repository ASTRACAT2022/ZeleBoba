#!/usr/bin/env php
<?php
declare(strict_types=1);
use Symfony\Component\Console\{Application,Command\Command,Input\InputInterface,Output\OutputInterface,Input\InputOption,Input\InputArgument};
use App\Infrastructure\Database;
$c=require dirname(__DIR__).'/bootstrap.php';
$cli=new Application('ZeleBoba Billing','0.2.0');
$cli->add((new Command('db:migrate'))->setDescription('Apply versioned migrations')->setCode(function(InputInterface $i,OutputInterface $o) use($c){$c->db->migrate(dirname(__DIR__).'/migrations');$o->writeln('Migrations applied.');return 0;}));
$cli->add((new Command('db:seed'))->setDescription('Create initial example plans; never creates accounts')->setCode(function(InputInterface $i,OutputInterface $o) use($c){
    foreach ([['basic','Старт',19900,30,100*1073741824,3],['plus','Свобода',49900,90,0,5],['max','Горизонт',159900,365,0,10]] as [$id,$name,$price,$days,$traffic,$devices]) $c->db->execute('INSERT INTO plans(id,name,price_minor,currency,duration_days,traffic_bytes,devices,active) VALUES(?,?,?,?,?,?,?,1) ON CONFLICT(id) DO NOTHING',[$id,$name,$price,'RUB',$days,$traffic,$devices]);
    $o->writeln('Plans seeded.');return 0;
}));
$cli->add((new Command('user:admin'))->setDescription('Promote an existing registered account')->addArgument('email',InputArgument::REQUIRED)->setCode(function(InputInterface $i,OutputInterface $o) use($c){
    $count=$c->db->transaction(function()use($c,$i){$n=$c->db->execute("UPDATE users SET role='admin' WHERE email=?",[mb_strtolower($i->getArgument('email'))]);if($n)$c->billing->audit('cli','admin.granted',mb_strtolower($i->getArgument('email')));return $n;});
    $o->writeln($count?'Administrator granted.':'Account not found.');return $count?0:1;
}));
$cli->add((new Command('worker:run'))->setDescription('Process transactional outbox')->addOption('once',null,InputOption::VALUE_NONE)->setCode(function(InputInterface $i,OutputInterface $o) use($c){
    $running=true;
    if(function_exists('pcntl_async_signals')){pcntl_async_signals(true);pcntl_signal(SIGTERM,function()use(&$running){$running=false;});pcntl_signal(SIGINT,function()use(&$running){$running=false;});}
    $revision=-1;$heartbeat=0;
    do {
        if($revision!==$c->settings->revision()){$c=new \App\Container(array_intersect_key($c->config,array_flip(['DATABASE_DSN','DATABASE_USER','DATABASE_PASSWORD'])));$revision=$c->settings->revision();}
        if(time()-$heartbeat>10){\App\Infrastructure\Reconciler::heartbeat($c->db,'worker');$heartbeat=time();}
        $worked=$c->outbox->runOne($c->worker->handle(...));if($i->getOption('once'))return 0;if(!$worked)usleep(500000);
    }while($running);return 0;
}));
$cli->add((new Command('billing:reconcile'))->setDescription('Recheck pending provider payments and expire local subscriptions')->setCode(function(InputInterface $i,OutputInterface $o) use($c){
    $result=(new \App\Infrastructure\Reconciler($c))->run();$o->writeln('Reconciliation queued.');return $result;
}));
$cli->add((new Command('billing:audit'))->setDescription('Check ledger and paid order invariants')->setCode(function(InputInterface $i,OutputInterface $o) use($c){
    $errors=$c->db->all("SELECT o.id FROM orders o LEFT JOIN ledger_entries l ON l.order_id=o.id WHERE o.status IN ('paid','fulfilled') GROUP BY o.id HAVING COUNT(l.id)<>2 OR SUM(l.amount_minor)<>0");
    $missing=$c->db->all("SELECT o.id FROM orders o LEFT JOIN subscriptions s ON s.order_id=o.id LEFT JOIN payment_receipts p ON p.order_id=o.id WHERE o.status IN ('paid','fulfilled') AND (s.id IS NULL OR p.order_id IS NULL)");
    $count=count($errors)+count($missing);$o->writeln('Invariant violations: '.$count);return $count?1:0;
}));
$cli->add((new Command('app:install'))->setDescription('Create the initial owner; all service settings are in the web admin')->addArgument('email',InputArgument::REQUIRED)->setCode(function(InputInterface $i,OutputInterface $o) use($c){
    if($c->db->one("SELECT id FROM users WHERE role='admin' LIMIT 1")){$o->writeln('An administrator already exists.');return 1;}
    $question=(new \Symfony\Component\Console\Question\Question('Initial administrator password (12+ characters): '))->setHidden(true)->setHiddenFallback(false);
    $password=(new \Symfony\Component\Console\Helper\QuestionHelper())->ask($i,$o,$question);
    $c->db->transaction(function()use($c,$i,$password){
        $uid=$c->auth->register($i->getArgument('email'),$password);
        $c->db->execute("UPDATE users SET role='admin' WHERE id=?",[$uid]);$c->billing->audit('cli','owner.created',$uid);
    });
    $o->writeln('Owner created. Open /login, enable 2FA, then configure /admin/config. Sales are disabled by default.');return 0;
}));
$cli->add((new Command('app:doctor'))->setDescription('Check deployment configuration and runtime health')->setCode(function(InputInterface $i,OutputInterface $o)use($c){
    $ok=true;foreach(\App\Settings\Readiness::report($c) as $check){$ok=$ok&&$check['ok'];$o->writeln(($check['ok']?'[OK] ':'[NEEDS ACTION] ').$check['label']);}return $ok?0:1;
}));
$cli->add((new Command('db:grant-runtime'))->setDescription('Grant runtime access without ledger mutation or DDL')->setCode(function(InputInterface $i,OutputInterface $o)use($c){\App\Infrastructure\Permissions::grant($c->db);$o->writeln('Runtime permissions applied.');return 0;}));
$cli->add((new Command('app:health'))->setDescription('Check schema and optional process heartbeat')->addArgument('process',InputArgument::OPTIONAL)->setCode(function(InputInterface $i,OutputInterface $o)use($c){
    foreach(glob(dirname(__DIR__).'/migrations/*.sql') as $file)if(!$c->db->one('SELECT version FROM migrations WHERE version=?',[basename($file)]))return 1;
    if($name=$i->getArgument('process')){$row=$c->db->one('SELECT seen_at FROM runtime_heartbeats WHERE name=?',[$name]);if(!$row||(int)$row['seen_at']<time()-180)return 1;}
    $o->writeln('healthy');return 0;
}));
$cli->add((new Command('remnawave:sync'))->setDescription('Sync local subscriptions with Remnawave panel')->addOption('dry-run',null,InputOption::VALUE_NONE,'Check without fixing')->addOption('limit',null,InputOption::VALUE_REQUIRED,'Max subscriptions to check',50)->setCode(function(InputInterface $i,OutputInterface $o)use($c){
    $limit=(int)$i->getOption('limit'); if($limit<1||$limit>500) $limit=50;
    $dry=(bool)$i->getOption('dry-run');
    $sync=new \App\Integration\RemnawaveSync($c->db,new \App\Integration\RemnawaveProvisioner(\Symfony\Component\HttpClient\HttpClient::create(),$c->config['REMNAWAVE_URL'],$c->config['REMNAWAVE_TOKEN'],$c->config['REMNAWAVE_SQUAD_UUID']));
    $report=$sync->run($limit,!$dry);
    $o->writeln(sprintf('Checked %d, fixed %d, reprovisioned %d, disabled %d, missing %d, errors %d',$report['checked'],$report['fixed'],$report['reprovisioned'],$report['disabled'],$report['missing'],$report['errors']));
    foreach($report['details'] as $line) $o->writeln('  '.$line);
    return $report['errors']>0?1:0;
}));
$cli->add((new Command('telegram:poll'))->setDescription('Long-poll Telegram updates via mirror (no webhook needed)')->addOption('once',null,InputOption::VALUE_NONE,'Fetch one batch and exit')->setCode(function(InputInterface $i,OutputInterface $o) use($c){
    $running=true;
    if(function_exists('pcntl_async_signals')){pcntl_async_signals(true);pcntl_signal(SIGTERM,function()use(&$running){$running=false;});pcntl_signal(SIGINT,function()use(&$running){$running=false;});}
    $http=\Symfony\Component\HttpClient\HttpClient::create();
    $offset=0;$heartbeat=0;$revision=-1;
    do {
        if($revision!==$c->settings->revision()){$c=new \App\Container(array_intersect_key($c->config,array_flip(['DATABASE_DSN','DATABASE_USER','DATABASE_PASSWORD'])));$revision=$c->settings->revision();}
        $token=$c->config['TELEGRAM_BOT_TOKEN'];
        if($token===''){ $o->writeln('TELEGRAM_BOT_TOKEN not configured'); return 1; }
        $base=rtrim($c->config['TELEGRAM_API_BASE']??'https://astracattg.netlify.app','/');
        try {
            $resp=$http->request('GET',$base.'/bot'.$token.'/getUpdates',['query'=>['timeout'=>30,'offset'=>$offset,'allowed_updates'=>['message','callback_query','pre_checkout_query','chat_member']],'timeout'=>60,'max_duration'=>70])->toArray();
        } catch(\Throwable $e) {
            $o->writeln('getUpdates error: '.$e->getMessage());
            if($i->getOption('once')) return 1;
            sleep(3); continue;
        }
        if(!($resp['ok']??false)){ $o->writeln('getUpdates not ok: '.json_encode($resp)); if($i->getOption('once')) return 1; sleep(3); continue; }
        foreach(($resp['result']??[]) as $update){
            $id=(int)($update['update_id']??0);
            if($id>=$offset) $offset=$id+1;
            try { $c->telegram->receive($update); }
            catch(\Throwable $e){ $o->writeln('handle error update_id='.$id.': '.$e->getMessage()); }
        }
        if(time()-$heartbeat>10){ \App\Infrastructure\Reconciler::heartbeat($c->db,'telegram'); $heartbeat=time(); }
        if($i->getOption('once')) return 0;
    }while($running);
    return 0;
}));
exit($cli->run());
