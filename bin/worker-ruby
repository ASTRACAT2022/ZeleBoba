#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"

require_relative "../ruby_app/zeleboba"

options = { once: false, poll_interval: 1.0 }
OptionParser.new do |parser|
  parser.banner = "Usage: bin/worker-ruby [--once] [--poll-interval SECONDS]"
  parser.on("--once", "Process at most one queued job") { options[:once] = true }
  parser.on("--poll-interval SECONDS", Float, "Idle wait, default: 1 second") do |value|
    options[:poll_interval] = value.clamp(0.1, 60.0)
  end
end.parse!

container = Zeleboba::Container.new
worker = container.worker

if options[:once]
  exit(worker.run_once ? 0 : 1)
end

stopping = false
Signal.trap("TERM") { stopping = true }
Signal.trap("INT") { stopping = true }

until stopping
  begin
    processed = worker.run_once
    container.db.execute("INSERT INTO runtime_heartbeats(name,seen_at) VALUES('worker',?) ON CONFLICT(name) DO UPDATE SET seen_at=excluded.seen_at", [Time.now.to_i])
    sleep(options[:poll_interval]) unless processed
  rescue StandardError => e
    warn "worker error: #{e.class}: #{e.message}"
    sleep(options[:poll_interval])
  end
end
