{
  "name": "zeleboba/billing",
  "description": "Channel-independent subscription billing for Remnawave",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-sodium": "*",
    "nyholm/psr7": "^1.8",
    "open-telemetry/exporter-otlp": "^1.0",
    "open-telemetry/sdk": "^1.0",
    "symfony/console": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/http-client": "7.4.*",
    "symfony/http-foundation": "7.4.*",
    "symfony/routing": "7.4.*",
    "twig/twig": "^3.20"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "check": [
      "@test"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {},
    "platform": {
      "php": "8.4.0"
    }
  },
  "license": "proprietary"
}
