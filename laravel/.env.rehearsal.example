# Rehearsal-only environment. NEVER use these values anywhere else.
# This file is intended to be copied to .env.rehearsal and edited locally.

APP_NAME="ZeleBoba (rehearsal)"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8091

# A non-secret rehearsal key — generated locally by `php artisan key:generate`.
# Re-run for each rehearsal session if needed; do not reuse the production key.
APP_KEY=

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Postgres — local rehearsal instance, NOT the production zeleboba_postgres.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=zeleboba_rehearsal
DB_USERNAME=zeleboba_rehearsal
DB_PASSWORD=rehearsal_pwd
DB_SSLMODE=disable

# Redis — local rehearsal instance.
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Queue — Redis is required by the cutover gate, even in rehearsal.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=cookie
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Horizon — only available locally.
HORIZON_PATH=internal/horizon

# Payments — DEMO in rehearsal. cutover:check --production will reject this.
PAYMENT_DRIVER=demo
PROVISION_DRIVER=demo

# Provider secrets are intentionally empty in rehearsal. The cutover gate
# enforces that production credentials are supplied only when PAYMENT_DRIVER
# is yookassa/freekassa. Do not paste real credentials here.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
FREEKASSA_SHOP_ID=
FREEKASSA_API_KEY=
FREEKASSA_SECRET2=

# Remnawave — not wired in rehearsal. Demo provisioning path only.
REMNAWAVE_URL=
REMNAWAVE_TOKEN=
REMNAWAVE_SQUAD_UUID=

# Mail — local Mailpit for SMTP capture during rehearsal.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="rehearsal@zeleboba.local"
MAIL_FROM_NAME="${APP_NAME}"