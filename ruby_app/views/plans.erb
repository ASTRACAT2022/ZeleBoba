<section class="page-title">
  <div>
    <p class="eyebrow">Тарифы</p>
    <h1>Выберите подписку</h1>
    <p>Все условия фиксируются в заказе на момент оплаты.</p>
  </div>
</section>

<% if plans.empty? %>
  <div class="panel empty-state">
    <h2>Тарифы ещё не настроены</h2>
    <p>Запустите seed или добавьте тарифы через административный слой.</p>
  </div>
<% else %>
  <section class="grid plans-grid">
    <% plans.each_with_index do |plan, index| %>
      <article class="plan-card <%= index == 1 ? "featured" : "" %>">
        <div class="plan-top">
          <div>
            <div class="plan-name"><%= h(plan["name"]) %></div>
            <span class="hint"><%= h(plan["duration_days"]) %> дней доступа</span>
          </div>
          <% if index == 1 %><span class="status is-ok">Популярный</span><% end %>
        </div>
        <div>
          <div class="price"><%= rub(plan["price_minor"]) %></div>
          <span class="hint">Разовая оплата</span>
        </div>
        <ul class="features">
          <li><%= plan["traffic_bytes"].to_i.zero? ? "Безлимитный трафик" : "#{plan["traffic_bytes"].to_i / 1_073_741_824} ГБ трафика" %></li>
          <li>До <%= h(plan["devices"]) %> устройств</li>
          <li>Выдача доступа после оплаты</li>
        </ul>
        <form method="post" action="/orders">
          <input type="hidden" name="_csrf" value="<%= h(csrf_token) %>">
          <input type="hidden" name="plan_id" value="<%= h(plan["id"]) %>">
          <input type="hidden" name="idempotency_key" value="<%= h(Zeleboba::Infrastructure::Database.id) %>">
          <button type="submit">Купить</button>
        </form>
      </article>
    <% end %>
  </section>
<% end %>
