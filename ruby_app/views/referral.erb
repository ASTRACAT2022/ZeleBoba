<section class="page-title">
  <div>
    <p class="eyebrow">Рефералы</p>
    <h1>Партнёрская программа</h1>
    <p>Ссылка, приглашения и заявки на вывод.</p>
  </div>
</section>

<section class="grid metrics">
  <div class="metric"><p>Код</p><strong><%= h(stats["code"]) %></strong></div>
  <div class="metric"><p>Приглашения</p><strong><%= stats["referrals"].count %></strong></div>
  <div class="metric"><p>Заработано</p><strong><%= rub(stats["earnings_kopeks"]) %></strong></div>
  <div class="metric"><p>Бот</p><strong>@<%= h(telegram_username) %></strong></div>
</section>

<section class="panel" style="margin-top:16px">
  <div class="panel-header"><h2>Реферальная ссылка</h2></div>
  <div class="panel-body">
    <input class="input" readonly value="<%= h(app_container.config["APP_URL"].to_s.sub(%r{/$}, "")) %>/register?ref=<%= h(stats["code"]) %>">
  </div>
</section>

<section class="panel" style="margin-top:16px">
  <div class="panel-header"><h2>История</h2></div>
  <% if stats["referrals"].empty? %>
    <div class="empty-state"><h2>Пока нет приглашений</h2><p>Когда пользователи придут по ссылке, они появятся здесь.</p></div>
  <% else %>
    <table class="data-table">
      <thead><tr><th>Пользователь</th><th>Статус</th><th>Дата</th></tr></thead><tbody><% stats["referrals"].each do |ref| %><tr><td><%= h(ref["email"].to_s.empty? ? "Telegram #{ref["telegram_id"]}" : ref["email"]) %></td><td><span class="status <%= ref["has_made_first_topup"].to_i == 1 ? "is-ok" : "is-muted" %>"><%= ref["has_made_first_topup"].to_i == 1 ? "Пополнял" : "Ожидает" %></span></td><td><%= date_time(ref["created_at"]) %></td></tr><% end %></tbody>
    </table>
  <% end %>
</section>

<section class="grid two-col" style="margin-top:16px">
  <div class="panel"><div class="panel-header"><h2>Запросить вывод</h2></div><div class="panel-body">
    <% if withdrawal_enabled %><form class="auth-form" method="post" action="/referral/withdraw"><input type="hidden" name="_csrf" value="<%= h(csrf_token) %>"><label class="field"><span>Сумма, ₽ (от <%= min_withdrawal / 100 %>)</span><input class="input" name="amount" type="number" min="<%= min_withdrawal / 100 %>" required></label><label class="field"><span>Реквизиты</span><input class="input" name="payment_details" minlength="5" maxlength="500" required></label><button type="submit">Отправить заявку</button></form><% else %><p class="hint">Вывод временно отключён.</p><% end %>
  </div></div>
  <div class="panel"><div class="panel-header"><h2>Заявки</h2></div><% if withdrawals.empty? %><div class="empty-state"><h2>Заявок нет</h2><p>История выплат появится здесь.</p></div><% else %><table class="data-table"><thead><tr><th>Сумма</th><th>Статус</th><th>Дата</th></tr></thead><tbody><% withdrawals.each do |row| %><tr><td><%= rub(row["amount_kopeks"]) %></td><td><span class="status <%= status_class(row["status"]) %>"><%= status_label(row["status"]) %></span></td><td><%= date_time(row["created_at"]) %></td></tr><% end %></tbody></table><% end %></div>
</section>
