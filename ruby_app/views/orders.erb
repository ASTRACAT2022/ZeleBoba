<section class="page-title">
  <div>
    <p class="eyebrow">Заказы</p>
    <h1>История оплат</h1>
    <p>Статусы заказов и ссылки на детали подписок.</p>
  </div>
  <a class="button" href="/plans">Новый заказ</a>
</section>

<div class="panel">
  <% if orders.empty? %>
    <div class="empty-state">
      <h2>Заказов пока нет</h2>
      <p>После выбора тарифа здесь появится история оплат.</p>
    </div>
  <% else %>
    <table class="data-table">
      <thead><tr><th>Заказ</th><th>Тариф</th><th>Цена</th><th>Статус</th><th>Дата</th><th></th></tr></thead>
      <tbody>
        <% orders.each do |order| %>
          <tr>
            <td><span class="hint"><%= short_id(order["id"]) %></span></td>
            <td><strong><%= h(order["plan_name"]) %></strong></td>
            <td><%= rub(order["price_minor"]) %></td>
            <td><span class="status <%= status_class(order["status"]) %>"><%= status_label(order["status"]) %></span></td>
            <td><%= date_time(order["created_at"]) %></td>
            <td><a class="button secondary" href="/orders/<%= h(order["id"]) %>">Открыть</a></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
