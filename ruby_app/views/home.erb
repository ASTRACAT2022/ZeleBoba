<section class="page-title">
  <div>
    <p class="eyebrow">Обзор</p>
    <h1>Рабочий стол</h1>
    <p>Подписки, заказы и баланс без лишнего шума.</p>
  </div>
  <a class="button" href="/plans">Купить подписку</a>
</section>

<section class="grid metrics">
  <div class="metric"><p>Активные подписки</p><strong><%= active_subscriptions %></strong></div>
  <div class="metric"><p>Баланс</p><strong><%= rub(balance) %></strong></div>
  <div class="metric"><p>Ожидают оплаты</p><strong><%= pending_orders %></strong></div>
  <div class="metric"><p>Ближайшее окончание</p><strong><%= next_subscription ? days_left(next_subscription["expires_at"]) : "—" %></strong></div>
</section>

<section class="grid two-col" style="margin-top:16px">
  <div class="panel">
    <div class="panel-header">
      <h2>Подписки</h2>
      <a class="button secondary" href="/plans">Тарифы</a>
    </div>
    <% if subscriptions.empty? %>
      <div class="empty-state">
        <h2>Подписок пока нет</h2>
        <p>Выберите тариф, и здесь появится срок действия доступа.</p>
      </div>
    <% else %>
      <table class="data-table">
        <thead><tr><th>Тариф</th><th>Статус</th><th>Действует до</th><th>Осталось</th></tr></thead>
        <tbody>
          <% subscriptions.each do |sub| %>
            <tr>
              <td><strong><%= h(sub["plan_name"]) %></strong></td>
              <td><span class="status <%= status_class(sub["status"]) %>"><%= status_label(sub["status"]) %></span></td>
              <td><%= date_time(sub["expires_at"]) %></td>
              <td><%= days_left(sub["expires_at"]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>

  <div class="panel">
    <div class="panel-header">
      <h2>Последние заказы</h2>
      <a class="button secondary" href="/orders">Все</a>
    </div>
    <% if orders.empty? %>
      <div class="empty-state">
        <h3>Заказов нет</h3>
        <p>После покупки последние операции появятся здесь.</p>
      </div>
    <% else %>
      <table class="data-table">
        <tbody>
          <% orders.each do |order| %>
            <tr>
              <td>
                <a href="/orders/<%= h(order["id"]) %>"><strong><%= h(order["plan_name"]) %></strong></a><br>
                <span class="hint"><%= short_id(order["id"]) %></span>
              </td>
              <td><span class="status <%= status_class(order["status"]) %>"><%= status_label(order["status"]) %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</section>
