<div class="auth-shell">
  <section class="auth-panel">
    <div class="auth-card">
      <p class="eyebrow">Telegram magic link</p>
      <h1>Одноразовый вход</h1>
      <p>Используйте только ссылку, которую запросили лично вы.</p>
      <% if error %><p class="error"><%= h(error) %></p><% end %>
      <form class="auth-form" method="post" action="/telegram/magic">
        <input type="hidden" name="_csrf" value="<%= h(csrf_token) %>">
        <label class="field">
          <span>Token</span>
          <input class="input" name="token" value="<%= h(token) %>" placeholder="magic token">
        </label>
        <button type="submit">Войти</button>
      </form>
      <p><a href="/login">Войти другим способом</a></p>
    </div>
  </section>
</div>
