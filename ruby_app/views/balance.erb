<section class="page-title">
  <div>
    <p class="eyebrow">Баланс</p>
    <h1><%= rub(balance) %></h1>
    <p>Внутренний кошелёк для покупок и продлений.</p>
  </div>
  <a class="button secondary" href="/plans">Оплатить тариф</a>
</section>

<section class="grid two-col">
  <div class="panel">
    <div class="panel-header"><h2>Пополнить баланс</h2></div>
    <div class="panel-body">
      <form class="auth-form" method="post" action="/balance/topup">
        <input type="hidden" name="_csrf" value="<%= h(csrf_token) %>">
        <input type="hidden" name="idempotency_key" value="<%= h(key) %>">
        <label class="field"><span>Сумма, ₽</span><input class="input" name="amount" type="number" min="1" max="1000000" step="1" required placeholder="Например, 500"></label>
        <label class="field"><span>Способ оплаты</span><select class="input" name="provider"><option value="demo">Демо-оплата</option><% if app_container.config["PAYMENT_DRIVER"] == "platega" %><option value="platega">Platega</option><% end %></select></label>
        <button type="submit">Перейти к оплате</button>
      </form>
    </div>
  </div>
  <div class="panel">
    <div class="panel-header"><h2>Быстрые действия</h2></div>
    <div class="panel-body action-stack">
      <a class="button secondary" href="/plans">Купить подписку</a>
      <a class="button secondary" href="/promo">Активировать промокод</a>
      <a class="button secondary" href="/gifts">Подарить подписку</a>
    </div>
  </div>
</section>

<section class="panel" style="margin-top:16px">
  <div class="panel-header"><h2>Пополнения</h2></div>
  <% if topups.empty? %>
    <div class="empty-state"><h2>Пополнений пока нет</h2><p>Созданные платежи появятся здесь.</p></div>
  <% else %>
    <table class="data-table"><thead><tr><th>Сумма</th><th>Статус</th><th>Создано</th><th></th></tr></thead><tbody>
      <% topups.each do |topup| %><tr><td><strong><%= rub(topup["amount_kopeks"]) %></strong></td><td><span class="status <%= status_class(topup["status"]) %>"><%= status_label(topup["status"]) %></span></td><td><%= date_time(topup["created_at"]) %></td><td><a href="/balance/topup/<%= h(topup["id"]) %>">Открыть</a></td></tr><% end %>
    </tbody></table>
  <% end %>
</section>

<div class="panel">
  <div class="panel-header"><h2>История операций</h2></div>
  <% if history.empty? %>
    <div class="empty-state">
      <h2>Операций пока нет</h2>
      <p>Пополнения и покупки с баланса появятся в этой ленте.</p>
    </div>
  <% else %>
    <table class="data-table">
      <thead><tr><th>Описание</th><th>Тип</th><th>Сумма</th><th>Дата</th></tr></thead>
      <tbody>
        <% history.each do |tx| %>
          <tr>
            <td><strong><%= h(tx["description"]) %></strong></td>
            <td><span class="hint"><%= h(tx["type"]) %></span></td>
            <td><%= rub(tx["amount_kopeks"]) %></td>
            <td><%= date_time(tx["created_at"]) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
