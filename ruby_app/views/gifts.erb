<section class="page-title">
  <div>
    <p class="eyebrow">Подарки</p>
    <h1>Подарочные подписки</h1>
    <p>Покупка подписки для другого пользователя и история активаций.</p>
  </div>
</section>

<section class="grid two-col">
  <div class="panel">
    <div class="panel-header"><h2>Купить подарок</h2></div>
    <div class="panel-body">
      <% unless gift_enabled %>
        <p class="hint">Подарки временно отключены.</p>
      <% else %>
      <% if plans.empty? %>
        <p class="hint">Нет активных тарифов.</p>
      <% else %>
        <form class="auth-form" method="post" action="/gifts/buy">
          <input type="hidden" name="_csrf" value="<%= h(csrf_token) %>">
          <input type="hidden" name="idempotency_key" value="<%= h(Zeleboba::Infrastructure::Database.id) %>">
          <label class="field">
            <span>Тариф</span>
            <select class="input" name="plan_id">
              <% plans.each do |plan| %>
                <option value="<%= h(plan["id"]) %>"><%= h(plan["name"]) %> — <%= rub(plan["price_minor"]) %></option>
              <% end %>
            </select>
          </label>
          <label class="field"><span>Кому (необязательно)</span><input class="input" name="recipient_value" placeholder="@username или e-mail"></label>
          <input type="hidden" name="recipient_type" value="contact">
          <label class="field"><span>Сообщение к подарку</span><input class="input" name="gift_message" maxlength="500" placeholder="Пусть интернет будет спокойнее"></label>
          <button type="submit">Создать подарок</button>
        </form>
      <% end %>
      <% end %>
    </div>
  </div>

  <div class="panel">
    <div class="panel-header"><h2>Получить подарок</h2></div>
    <div class="panel-body"><p class="hint">Вставьте код <code>GIFT_...</code> или ссылку от отправителя.</p><a class="button secondary" href="/gifts/claim">Активировать подарок</a></div>
  </div>
</section>

<section class="panel" style="margin-top:16px">
  <div class="panel-header"><h2>Отправленные подарки</h2></div>
  <% if bought.empty? %><div class="empty-state"><h2>Подарков пока нет</h2><p>После покупки здесь появится код для передачи получателю.</p></div><% else %>
    <table class="data-table"><thead><tr><th>Тариф</th><th>Код</th><th>Статус</th><th>Дата</th></tr></thead><tbody>
    <% bought.each do |gift| %><tr><td><strong><%= h(gift["plan_id"]) %></strong><br><span class="hint"><%= rub(gift["amount_kopeks"]) %></span></td><td><code><%= h(app_container.gifts.public_code(gift["token"])) %></code></td><td><span class="status <%= status_class(gift["status"]) %>"><%= status_label(gift["status"]) %></span></td><td><%= date_time(gift["created_at"]) %></td></tr><% end %>
    </tbody></table>
  <% end %>
</section>

<section class="panel" style="margin-top:16px">
  <div class="panel-header"><h2>Полученные подарки</h2></div>
  <% if received.empty? %><div class="empty-state"><h2>Пока ничего не получено</h2><p>Активированные подарки появятся здесь.</p></div><% else %>
    <table class="data-table"><thead><tr><th>Тариф</th><th>Статус</th><th>Активирован</th></tr></thead><tbody><% received.each do |gift| %><tr><td><%= h(gift["plan_id"]) %></td><td><span class="status is-ok">Активирован</span></td><td><%= date_time(gift["delivered_at"]) %></td></tr><% end %></tbody></table>
  <% end %>
</section>
