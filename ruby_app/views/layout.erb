<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= h(app_container.config["SITE_NAME"]) %></title>
  <link rel="stylesheet" href="/saas.css">
</head>
<body>
  <% if current_user %>
    <div class="app-shell">
      <aside class="sidebar">
        <div class="brand">
          <span class="brand-mark"><img src="/branding/zeleboba-logo.png" alt=""></span>
          <span><%= h(app_container.config["SITE_NAME"]) %></span>
        </div>
        <nav class="nav-group" aria-label="Основная навигация">
          <% [["/", "Обзор"], ["/plans", "Тарифы"], ["/orders", "Заказы"], ["/balance", "Баланс"], ["/promo", "Промокод"], ["/gifts", "Подарки"], ["/referral", "Рефералы"], ["/security", "Безопасность"], ["/settings", "Настройки"]].each do |path, label| %>
            <a class="nav-link <%= active_nav?(path) ? "active" : "" %>" href="<%= path %>"><span class="nav-dot"></span><%= label %></a>
          <% end %>
          <% if current_user["role"] == "admin" %>
            <a class="nav-link <%= active_nav?("/admin") ? "active" : "" %>" href="/admin"><span class="nav-dot"></span>Админка</a>
          <% end %>
        </nav>
        <div class="sidebar-footer">
          <span class="hint">Аккаунт</span>
          <strong><%= h(current_user["email"] || current_user["telegram_id"]) %></strong>
        </div>
      </aside>
      <main class="content">
        <header class="topbar">
          <div>
            <div class="eyebrow">Billing console</div>
            <strong><%= h(app_container.config["SITE_NAME"]) %></strong>
          </div>
          <div class="topbar-actions">
            <a class="button secondary" href="/plans">Новая покупка</a>
            <form class="inline-form" method="post" action="/logout">
              <input type="hidden" name="_csrf" value="<%= h(csrf_token) %>">
              <button class="secondary" type="submit">Выйти</button>
            </form>
          </div>
        </header>
        <%= yield %>
      </main>
    </div>
  <% else %>
    <%= yield %>
  <% end %>
</body>
</html>
