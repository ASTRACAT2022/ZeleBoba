<section class="page-title">
  <div>
    <p class="eyebrow">Безопасность</p>
    <h1>Доступ и аудит</h1>
    <p>Сессии, Telegram-вход и последние события аккаунта.</p>
  </div>
</section>

<section class="grid two-col">
  <div class="panel">
    <div class="panel-header"><h2>Активные сессии</h2></div>
    <table class="data-table">
      <thead><tr><th>Сессия</th><th>Истекает</th><th>Admin step-up</th></tr></thead>
      <tbody>
        <% sessions.each do |session| %>
          <tr>
            <td><span class="hint"><%= short_id(session["id"]) %></span></td>
            <td><%= date_time(session["expires_at"]) %></td>
            <td><%= session["admin_verified_until"].to_i > Time.now.to_i ? "активен" : "нет" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="panel">
    <div class="panel-header"><h2>Telegram</h2></div>
    <div class="panel-body">
      <p class="hint">Вход через Telegram работает через challenge: браузер создаёт запрос, бот подтверждает Telegram ID, после чего выдаётся обычная сессия.</p>
      <form method="post" action="/telegram/start">
        <input type="hidden" name="_csrf" value="<%= h(csrf_token) %>">
        <button type="submit">Проверить Telegram-вход</button>
      </form>
    </div>
  </div>
</section>

<section class="panel" style="margin-top:16px">
  <div class="panel-header"><h2>Последний аудит</h2></div>
  <% if audits.empty? %>
    <div class="empty-state"><h2>Событий пока нет</h2><p>Входы и операции появятся здесь.</p></div>
  <% else %>
    <table class="data-table">
      <thead><tr><th>Событие</th><th>Объект</th><th>Дата</th></tr></thead>
      <tbody>
        <% audits.each do |event| %>
          <tr><td><%= h(event["action"]) %></td><td><%= h(event["subject"]) %></td><td><%= date_time(event["created_at"]) %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
