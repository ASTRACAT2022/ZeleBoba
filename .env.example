# Only database connection belongs here. Service settings are in /admin/config.
# Local development:
DATABASE_DSN=sqlite:var/billing.sqlite
DATABASE_USER=
DATABASE_PASSWORD=
# Docker Compose uses its internal PostgreSQL DSN; set a strong DATABASE_PASSWORD.
# Native PostgreSQL example:
# DATABASE_DSN=pgsql:host=127.0.0.1;port=5432;dbname=billing
# DATABASE_USER=billing
# Docker database owner; never reuse the runtime password.
DATABASE_MIGRATION_PASSWORD=
